#!/usr/bin/env bash
# rq-review — the only thing review-queue's key may run on this dev box.
#
# Install:
#   sudo install -m 0755 rq-review /usr/local/bin/rq-review
#   # then add the key line the dashboard shows to ~/.ssh/authorized_keys:
#   #   command="/usr/local/bin/rq-review",restrict ssh-rsa AAAA... review-queue
#
# The forced command means the dashboard cannot choose what runs here. Whatever
# it sends arrives whole in $SSH_ORIGINAL_COMMAND, and this script decides.
# Nothing below is ever passed to eval, and every field is checked against a
# strict pattern before it is used.
set -euo pipefail

# --- settings ---------------------------------------------------------------
# Repositories this box will review. Anything else is refused.
ALLOWED_REPOS="${RQ_ALLOWED_REPOS:-ubicloud/ubicloud}"
# The checkout bay runs from. bay finds its config by this folder's name.
REPO_PATH="${RQ_REPO_PATH:-$HOME/ubicloud}"
# Look where bay actually lands, not one hard-coded path: go install puts it in
# ~/go/bin, a package or a manual copy usually lands in /usr/local/bin, and a
# custom build can be anywhere on PATH.
resolve_bay() {
  if [ -n "${RQ_BAY:-}" ] && [ -x "${RQ_BAY}" ]; then echo "$RQ_BAY"; return 0; fi
  local c
  for c in "$HOME/go/bin/bay" /usr/local/bin/bay /usr/bin/bay "$HOME/.local/bin/bay"; do
    [ -x "$c" ] && { echo "$c"; return 0; }
  done
  c=$(command -v bay 2>/dev/null) && [ -n "$c" ] && { echo "$c"; return 0; }
  return 1
}
BAY="$(resolve_bay || true)"
STATE_DIR="${RQ_STATE_DIR:-$HOME/.rq}"
BAY_CONFIG="${RQ_BAY_CONFIG:-$HOME/.bay/ubicloud}"

die() { echo "rq-review: $*" >&2; exit 1; }

# --- parse, without a shell ---------------------------------------------------
read -r -a ARGV <<< "${SSH_ORIGINAL_COMMAND:-}"
verb="${ARGV[0]:-}"

valid_box()  { [[ "$1" =~ ^[a-z0-9][a-z0-9-]{0,48}$ ]]; }
valid_pr()   { [[ "$1" =~ ^[0-9]{1,7}$ ]]; }
valid_repo() {
  [[ "$1" =~ ^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$ ]] || return 1
  # Split on whitespace WITHOUT pathname expansion. Unquoted `for r in
  # $ALLOWED_REPOS` globs against the working directory, so a natural
  # wildcard entry like "ubicloud/*" expands to the checkout's filenames --
  # refusing the intended repo and accepting whatever files happen to sit
  # there. This is the boundary a stolen key runs into, so it must be exact.
  local r
  local -a allowed
  read -r -a allowed <<< "$ALLOWED_REPOS"
  for r in "${allowed[@]}"; do [ "$r" = "$1" ] && return 0; done
  return 1
}

case "$verb" in
  ping)
    # Proves the key, this script, bay and the checkout are all in place. Say
    # what is missing and where it was looked for, so a failure is actionable.
    if [ -z "$BAY" ]; then
      die "bay not found. Looked in: \$RQ_BAY, ~/go/bin/bay, /usr/local/bin/bay, /usr/bin/bay, ~/.local/bin/bay, \$PATH.
          Run devbox/setup.sh to build it, or set RQ_BAY to its path.
          Note bay is a private repo: your GITHUB_TOKEN needs Contents: Read on ubicloud/bay."
    fi
    [ -d "$REPO_PATH" ] || die "checkout not found at $REPO_PATH (set RQ_REPO_PATH if it is elsewhere)"
    [ -f "$BAY_CONFIG/bay.toml" ] || die "bay config not found at $BAY_CONFIG (private repo: ubicloud/bay-ubicloud)"
    echo "pong $(hostname) bay=$BAY"
    ;;

  review)
    [ -n "$BAY" ] || die "bay not found; run setup.sh or set RQ_BAY"
    [ "${#ARGV[@]}" -eq 4 ] || die "usage: review <owner/repo> <pr> <box>"
    repo="${ARGV[1]:-}"; pr="${ARGV[2]:-}"; box="${ARGV[3]:-}"
    if ! valid_repo "$repo"; then
      case "$ALLOWED_REPOS" in
        *[*?]*) die "repo not allowed: ${repo:-<empty>}
          RQ_ALLOWED_REPOS is matched exactly and does not take wildcards.
          List each repository in full, separated by spaces." ;;
        *) die "repo not allowed: ${repo:-<empty>} (allowed: $ALLOWED_REPOS)" ;;
      esac
    fi
    valid_pr   "$pr"   || die "bad pull request number"
    valid_box  "$box"  || die "bad box name"

    dir="$STATE_DIR/$box"
    mkdir -p "$dir"
    # The states this script writes are building/reviewing/done/failed. An
    # earlier version wrote "running", and this guard kept testing for it --
    # dead, so a second Review started concurrently in the same worktree and
    # truncated the first review's log.
    if [ -f "$dir/state" ] && grep -qE '^(building|reviewing)$' "$dir/state" 2>/dev/null \
       && [ -f "$dir/pid" ] && kill -0 "$(cat "$dir/pid")" 2>/dev/null; then
      echo "already running"; exit 0
    fi

    # Two logs on purpose. build.log is bay's container noise; log holds ONLY
    # what claude wrote, because that is the thing worth watching.
    echo building > "$dir/state"
    : > "$dir/log"
    : > "$dir/build.log"

    # A review takes minutes, so it must outlive this ssh connection. The
    # dashboard polls with `status` and collects with `result`.
    setsid nohup bash -c '
      set -o pipefail
      bay="$1"; repo="$2"; pr="$3"; box="$4"; dir="$5"; repo_path="$6"
      cd "$repo_path" || { echo "cannot cd to $repo_path" >> "$dir/build.log"; echo failed > "$dir/state"; exit 1; }

      if ! "$bay" up "$box" --pr "$pr" >> "$dir/build.log" 2>&1; then
        echo failed > "$dir/state"
        exit 1
      fi

      echo reviewing > "$dir/state"
      # No tty needed: verified with docker compose v5.5.0, bay run exits 0
      # over a plain ssh exec with stdin closed.
      if "$bay" run "$box" review </dev/null >> "$dir/log" 2>&1; then
        echo done > "$dir/state"
      else
        echo failed > "$dir/state"
      fi
    ' _ "$BAY" "$repo" "$pr" "$box" "$dir" "$REPO_PATH" >/dev/null 2>&1 &

    echo "$!" > "$dir/pid"
    echo "started $box"
    ;;

  ask)
    # A follow-up question in a box that already ran a review.
    #
    # The text arrives on STDIN, never as an argument, so the command line stays
    # exactly as strict as every other verb and nothing in the question can
    # affect parsing. It is written to a file and read back by the bay command
    # with "$(cat ...)", so it is one shell word there too -- never eval'd.
    box="${ARGV[1]:-}"; valid_box "$box" || die "bad box name"
    [ -n "$BAY" ] || die "bay not found"
    dir="$STATE_DIR/$box"
    [ -d "$dir" ] || die "no review has run for $box"

    wt="$REPO_PATH/.worktrees/$box"
    [ -d "$wt" ] || die "no worktree for $box; has the box been torn down?"

    if [ -f "$dir/state" ] && grep -qE '^(building|reviewing)$' "$dir/state" 2>/dev/null \
       && [ -f "$dir/pid" ] && kill -0 "$(cat "$dir/pid")" 2>/dev/null; then
      die "that box is still working; wait for it to finish"
    fi

    mkdir -p "$wt/.rq"
    # Bounded: a prompt is a question, not a payload.
    head -c 8192 > "$wt/.rq/followup.txt"
    [ -s "$wt/.rq/followup.txt" ] || die "empty follow-up"

    echo reviewing > "$dir/state"
    {
      echo
      echo "--- follow-up ---"
      cat "$wt/.rq/followup.txt"
      echo
    } >> "$dir/log"

    setsid nohup bash -c '
      bay="$1"; box="$2"; dir="$3"; repo_path="$4"
      cd "$repo_path" || { echo failed > "$dir/state"; exit 1; }
      if "$bay" run "$box" ask </dev/null >> "$dir/log" 2>&1; then
        echo done > "$dir/state"
      else
        echo failed > "$dir/state"
      fi
    ' _ "$BAY" "$box" "$dir" "$REPO_PATH" >/dev/null 2>&1 &

    echo "$!" > "$dir/pid"
    echo "asked $box"
    ;;

  status)
    [ "${#ARGV[@]}" -eq 2 ] || die "usage: status <box>"
    box="${ARGV[1]:-}"; valid_box "$box" || die "bad box name"
    dir="$STATE_DIR/$box"
    [ -f "$dir/state" ] && cat "$dir/state" || echo unknown
    ;;

  result)
    # Claude's output only. Use `build` for bay's side of it.
    [ "${#ARGV[@]}" -eq 2 ] || die "usage: result <box>"
    box="${ARGV[1]:-}"; valid_box "$box" || die "bad box name"
    dir="$STATE_DIR/$box"
    # tail -c cuts at a byte offset, so it can split a multibyte character and
    # the invalid UTF-8 then makes Postgres reject the whole write, wedging the
    # job. iconv -c drops any partial sequence at the boundary.
    [ -f "$dir/log" ] && tail -c 200000 "$dir/log" | iconv -c -f utf-8 -t utf-8 || true
    ;;

  build)
    [ "${#ARGV[@]}" -eq 2 ] || die "usage: build <box>"
    box="${ARGV[1]:-}"; valid_box "$box" || die "bad box name"
    dir="$STATE_DIR/$box"
    [ -f "$dir/build.log" ] && tail -c 40000 "$dir/build.log" | iconv -c -f utf-8 -t utf-8 || true
    ;;

  list)
    [ -n "$BAY" ] || die "bay not found; run setup.sh or set RQ_BAY"
    # One line per box: name, branch, and whether its container is up. A box
    # outlives its review, so the dashboard cannot infer this from its own rows.
    cd "$REPO_PATH" || die "checkout not found at $REPO_PATH"
    "$BAY" list 2>/dev/null | awk '/\.worktrees\// {
        n = $1; sub(/.*\/\.worktrees\//, "", n)
        br = $NF; gsub(/[\[\]]/, "", br)
        print n "\t" br
      }' | while IFS=$'\t' read -r name branch; do
      # set -e would abort the whole verb on a failed substitution, so /sessions
      # would show "No boxes" on a box where docker is simply not reachable.
      up=$(docker ps --filter "name=bay-.*-${name}-app" --format '{{.Status}}' 2>/dev/null | head -1) || true
      printf '%s\t%s\t%s\n' "$name" "$branch" "${up:-stopped}"
    done
    ;;

  teardown)
    [ -n "$BAY" ] || die "bay not found; run setup.sh or set RQ_BAY"
    [ "${#ARGV[@]}" -eq 2 ] || die "usage: teardown <box>"
    box="${ARGV[1]:-}"; valid_box "$box" || die "bad box name"
    cd "$REPO_PATH" || die "checkout not found at $REPO_PATH"
    # --force on purpose. post-create.sh writes .env.rb and builds CSS into the
    # worktree, so a review box is ALWAYS dirty and plain `bay down` always
    # refuses. There is nothing worth keeping in a review checkout.
    if out=$("$BAY" down "$box" --force 2>&1); then
      rm -rf "${STATE_DIR:?}/$box"
      echo "torn down $box"
    else
      # Do not report success for a box that is still there.
      echo "$out" >&2
      exit 1
    fi
    ;;

  *)
    die "refused: only ping, review, ask, status, result, build, list and teardown are allowed"
    ;;
esac
