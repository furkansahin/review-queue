#!/usr/bin/env bash
# rq-review — the only thing review-queue's key may run on this dev box.
#
# Install:
#   sudo install -m 0755 rq-review /usr/local/bin/rq-review
#   # then add the key line the dashboard shows to ~/.ssh/authorized_keys:
#   #   command="/usr/local/bin/rq-review",restrict ssh-rsa AAAA... review-queue
#
# The forced command means the dashboard cannot choose what runs here. Whatever
# it sends arrives whole in $SSH_ORIGINAL_COMMAND, and this script decides.
# Nothing below is ever passed to eval, and every field is checked against a
# strict pattern before it is used.
set -euo pipefail

# --- settings ---------------------------------------------------------------
# Repositories this box will review. Anything else is refused.
ALLOWED_REPOS="${RQ_ALLOWED_REPOS:-ubicloud/ubicloud}"
# The checkout bay runs from. bay finds its config by this folder's name.
REPO_PATH="${RQ_REPO_PATH:-$HOME/ubicloud}"
# Look where bay actually lands, not one hard-coded path: go install puts it in
# ~/go/bin, a package or a manual copy usually lands in /usr/local/bin, and a
# custom build can be anywhere on PATH.
resolve_bay() {
  if [ -n "${RQ_BAY:-}" ] && [ -x "${RQ_BAY}" ]; then echo "$RQ_BAY"; return 0; fi
  local c
  for c in "$HOME/go/bin/bay" /usr/local/bin/bay /usr/bin/bay "$HOME/.local/bin/bay"; do
    [ -x "$c" ] && { echo "$c"; return 0; }
  done
  c=$(command -v bay 2>/dev/null) && [ -n "$c" ] && { echo "$c"; return 0; }
  return 1
}
BAY="$(resolve_bay || true)"
STATE_DIR="${RQ_STATE_DIR:-$HOME/.rq}"

die() { echo "rq-review: $*" >&2; exit 1; }

# --- parse, without a shell ---------------------------------------------------
read -r -a ARGV <<< "${SSH_ORIGINAL_COMMAND:-}"
verb="${ARGV[0]:-}"

valid_box()  { [[ "$1" =~ ^[a-z0-9][a-z0-9-]{0,48}$ ]]; }
valid_pr()   { [[ "$1" =~ ^[0-9]{1,7}$ ]]; }
valid_repo() {
  [[ "$1" =~ ^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$ ]] || return 1
  local r
  for r in $ALLOWED_REPOS; do [ "$r" = "$1" ] && return 0; done
  return 1
}

case "$verb" in
  ping)
    # Proves the key, this script, bay and the checkout are all in place. Say
    # what is missing and where it was looked for, so a failure is actionable.
    if [ -z "$BAY" ]; then
      die "bay not found. Looked in: \$RQ_BAY, ~/go/bin/bay, /usr/local/bin/bay, /usr/bin/bay, ~/.local/bin/bay, \$PATH.
          Run devbox/setup.sh to build it, or set RQ_BAY to its path.
          Note bay is a private repo: your GITHUB_TOKEN needs Contents: Read on ubicloud/bay."
    fi
    [ -d "$REPO_PATH" ] || die "checkout not found at $REPO_PATH (set RQ_REPO_PATH if it is elsewhere)"
    [ -f "$HOME/.bay/ubicloud/bay.toml" ] || die "bay config not found at ~/.bay/ubicloud (private repo: ubicloud/bay-ubicloud)"
    echo "pong $(hostname) bay=$BAY"
    ;;

  review)
    repo="${ARGV[1]:-}"; pr="${ARGV[2]:-}"; box="${ARGV[3]:-}"
    valid_repo "$repo" || die "repo not allowed: ${repo:-<empty>}"
    valid_pr   "$pr"   || die "bad pull request number"
    valid_box  "$box"  || die "bad box name"

    dir="$STATE_DIR/$box"
    mkdir -p "$dir"
    if [ -f "$dir/state" ] && [ "$(cat "$dir/state")" = "running" ] \
       && [ -f "$dir/pid" ] && kill -0 "$(cat "$dir/pid")" 2>/dev/null; then
      echo "already running"; exit 0
    fi

    # Two logs on purpose. build.log is bay's container noise; log holds ONLY
    # what claude wrote, because that is the thing worth watching.
    echo building > "$dir/state"
    : > "$dir/log"
    : > "$dir/build.log"

    # A review takes minutes, so it must outlive this ssh connection. The
    # dashboard polls with `status` and collects with `result`.
    setsid nohup bash -c '
      set -o pipefail
      bay="$1"; repo="$2"; pr="$3"; box="$4"; dir="$5"; repo_path="$6"
      cd "$repo_path" || { echo "cannot cd to $repo_path" >> "$dir/build.log"; echo failed > "$dir/state"; exit 1; }

      if ! "$bay" up "$box" --pr "$pr" >> "$dir/build.log" 2>&1; then
        echo failed > "$dir/state"
        exit 1
      fi

      echo reviewing > "$dir/state"
      # No tty needed: verified with docker compose v5.5.0, bay run exits 0
      # over a plain ssh exec with stdin closed.
      if "$bay" run "$box" review </dev/null >> "$dir/log" 2>&1; then
        echo done > "$dir/state"
      else
        echo failed > "$dir/state"
      fi
    ' _ "$BAY" "$repo" "$pr" "$box" "$dir" "$REPO_PATH" >/dev/null 2>&1 &

    echo "$!" > "$dir/pid"
    echo "started $box"
    ;;

  status)
    box="${ARGV[1]:-}"; valid_box "$box" || die "bad box name"
    dir="$STATE_DIR/$box"
    [ -f "$dir/state" ] && cat "$dir/state" || echo unknown
    ;;

  result)
    # Claude's output only. Use `build` for bay's side of it.
    box="${ARGV[1]:-}"; valid_box "$box" || die "bad box name"
    dir="$STATE_DIR/$box"
    [ -f "$dir/log" ] && tail -c 200000 "$dir/log" || true
    ;;

  build)
    box="${ARGV[1]:-}"; valid_box "$box" || die "bad box name"
    dir="$STATE_DIR/$box"
    [ -f "$dir/build.log" ] && tail -c 40000 "$dir/build.log" || true
    ;;

  list)
    # One line per box: name, branch, and whether its container is up. A box
    # outlives its review, so the dashboard cannot infer this from its own rows.
    cd "$REPO_PATH" || die "checkout not found at $REPO_PATH"
    "$BAY" list 2>/dev/null | awk '/\.worktrees\// {
        n = $1; sub(/.*\/\.worktrees\//, "", n)
        br = $NF; gsub(/[\[\]]/, "", br)
        print n "\t" br
      }' | while IFS=$'\t' read -r name branch; do
      up=$(docker ps --filter "name=bay-.*-${name}-app" --format '{{.Status}}' 2>/dev/null | head -1)
      printf '%s\t%s\t%s\n' "$name" "$branch" "${up:-stopped}"
    done
    ;;

  teardown)
    box="${ARGV[1]:-}"; valid_box "$box" || die "bad box name"
    cd "$REPO_PATH" || die "checkout not found at $REPO_PATH"
    # --force on purpose. post-create.sh writes .env.rb and builds CSS into the
    # worktree, so a review box is ALWAYS dirty and plain `bay down` always
    # refuses. There is nothing worth keeping in a review checkout.
    if out=$("$BAY" down "$box" --force 2>&1); then
      rm -rf "${STATE_DIR:?}/$box"
      echo "torn down $box"
    else
      # Do not report success for a box that is still there.
      echo "$out" >&2
      exit 1
    fi
    ;;

  *)
    die "refused: only ping, review, status, result, build, list and teardown are allowed"
    ;;
esac
