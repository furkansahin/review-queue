# Local dev only. On Dokku use `dokku config:set` (see setup.sh).
# GitHub OAuth App credentials; callback URL must be $RQ_BASE_URL/auth/callback
RQ_GITHUB_CLIENT_ID=Ov23xxxxxxxxxxxx
RQ_GITHUB_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RQ_BASE_URL=http://127.0.0.1:9292
# Encrypts stored dev box keys and tokens. 64 hex chars: openssl rand -hex 32
# Losing it makes every stored secret permanently unreadable.
RQ_ENCRYPTION_KEY=replace-me-with-64-hex-chars-from-openssl-rand-hex-32

# >= 64 chars: openssl rand -hex 32
RQ_SESSION_SECRET=replace-me-with-64-hex-chars-or-more-openssl-rand-hex-32-output
# Only these GitHub logins may sign in. Required; empty means nobody.
RQ_ALLOWED_LOGINS=me
# Send the session cookie over plain http (local dev only, never in production)
RQ_INSECURE_COOKIES=1
RQ_SCOPE=repo:ubicloud/ubicloud
# Only the placeholder shown in the watch-label box. NOT applied as a default:
# the watched label is per user and starts empty.
RQ_LABEL=clickhouse
RQ_WARN_DAYS=2
RQ_HOT_DAYS=4
RQ_STALE_DAYS=7
RQ_CACHE_TTL=300
# churn at or below which a PR shows in the Quick wins tab
RQ_QUICK_LINES=50
# rough review-reading rate behind the "~3m" estimate
RQ_LINES_PER_MIN=20
# drop a user's cached queue after this many idle seconds; cap concurrent users
RQ_IDLE_TTL=3600
# how many days a Snooze hides a row (new activity wakes it sooner)
RQ_SNOOZE_DAYS=7
RQ_MAX_USERS=25
# how many pull requests are fetched at once; each fans out again for its own
# timeline, so requests in flight are a few times this. Higher is faster, up to
# the point GitHub answers with a secondary rate limit.
RQ_CONCURRENCY=5
# Postgres connections per process. Defaults to RQ_PUMA_THREADS, because every
# busy Puma thread holds one.
# RQ_DB_POOL=16
PORT=9292
