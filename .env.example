# Local dev only. On Dokku use `dokku config:set` (see setup.sh).
GITHUB_TOKEN=github_pat_xxx
RQ_PASSWORD=pick-a-long-random-password
RQ_USER=me
RQ_SCOPE=repo:ubicloud/ubicloud
RQ_LABEL=clickhouse
RQ_WARN_DAYS=2
RQ_HOT_DAYS=4
RQ_STALE_DAYS=7
RQ_CACHE_TTL=300
# churn at or below which a PR shows in the Quick wins tab
RQ_QUICK_LINES=50
# rough review-reading rate behind the "~3m" estimate
RQ_LINES_PER_MIN=20
PORT=9292
