<%
  tabs = service.tabs
  counts = snap[:counts] || {}
  qs = ->(t, h) { "/?tab=#{t}#{h ? "&hide=1" : ""}" }
  cols = "4px 132px 1fr 92px 132px 150px 84px 76px 92px"
  snoozing = tab == :snoozed

  # A draft is listed but is not work for today, so it counts in neither
  # "to go" nor "done", and it never becomes Next up.
  drafts = rows.count { |r| !r[:settled] && r[:draft] }
  done = rows.count { |r| r[:settled] }
  active = rows.count { |r| !r[:settled] && !r[:draft] }
  total = active + done
  pct = total.zero? ? 100 : (done * 100.0 / total).round
  hero = snoozing ? nil : rows.find { |r| !r[:settled] && !r[:draft] }
  reviews_7d = snap[:reviews_7d]
%>
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta http-equiv="refresh" content="180" />
<title><%= active.zero? ? "" : "(#{active}) " %>Review queue</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="" />
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
<style>
  /* Light is the base palette; the dark block below only redefines the tokens.
     Row colours (state pills, age bars, CI dots, chips) are emitted as
     var(--...) by queue_service.rb, so both themes resolve from here. */
  :root {
    color-scheme: light;
    --bg: oklch(0.985 0.004 70);
    --fg: oklch(0.26 0.01 60);
    --surface: oklch(1 0 0);
    --border: oklch(0.9 0.006 70);
    --border-soft: oklch(0.94 0.004 70);
    --border-head: oklch(0.92 0.006 70);
    --muted: oklch(0.58 0.01 60);
    --muted-2: oklch(0.62 0.01 60);
    --muted-3: oklch(0.65 0.01 60);
    --cell: oklch(0.45 0.01 60);
    --link: oklch(0.45 0.11 250);
    --link-hover: oklch(0.38 0.13 250);
    --accent: oklch(0.45 0.11 250);
    --tab-on-fg: oklch(0.28 0.02 250);
    --tab-hover-fg: oklch(0.35 0.01 60);
    --badge-bg: oklch(0.96 0.004 70);
    --badge-fg: oklch(0.6 0.01 60);
    --badge-on-bg: oklch(0.95 0.03 250);
    --badge-on-fg: oklch(0.45 0.1 250);
    --btn-bg: oklch(1 0 0);
    --btn-border: oklch(0.88 0.006 70);
    --btn-fg: oklch(0.3 0.01 60);
    --btn-hover-bg: oklch(0.96 0.004 70);
    --row-hover: oklch(0.965 0.004 70);
    --tag-bg: oklch(0.96 0.004 70);
    --tag-border: oklch(0.91 0.006 70);
    --tag-fg: oklch(0.55 0.01 60);
    --err-bg: oklch(0.97 0.02 25);
    --err-border: oklch(0.82 0.09 25);
    --err-fg: oklch(0.42 0.12 25);
    --hero-bg: oklch(0.985 0.012 250);
    --hero-border: oklch(0.88 0.04 250);
    --track: oklch(0.93 0.005 70);
    --track-fill: oklch(0.72 0.13 150);
    --win-fg: oklch(0.5 0.13 150);
    --quick-fg: oklch(0.48 0.12 150);

    --row: oklch(1 0 0);
    --row-settled: oklch(0.995 0.002 70);
    --state-them-bg: oklch(0.95 0.01 250);   --state-them-fg: oklch(0.45 0.1 250);
    --state-done-bg: oklch(0.955 0.004 70);  --state-done-fg: oklch(0.55 0.01 60);
    --state-yours-bg: oklch(0.95 0.05 85);   --state-yours-fg: oklch(0.45 0.11 65);
    --state-todo-bg: oklch(0.94 0.06 25);    --state-todo-fg: oklch(0.45 0.14 25);
    --age-idle-bar: oklch(0.9 0.005 70);     --age-idle-fg: oklch(0.66 0.01 60);
    --age-stale-bar: oklch(0.55 0.17 25);    --age-stale-fg: oklch(0.48 0.16 25);
    --age-hot-bar: oklch(0.66 0.16 45);      --age-hot-fg: oklch(0.52 0.14 45);
    --age-warn-bar: oklch(0.78 0.14 85);     --age-warn-fg: oklch(0.55 0.11 75);
    --age-fresh-bar: oklch(0.72 0.13 150);   --age-fresh-fg: oklch(0.48 0.1 150);
    --ci-fail: oklch(0.58 0.17 25);
    --ci-pass: oklch(0.68 0.14 150);
    --ci-pending: oklch(0.78 0.13 85);
    --ci-none: oklch(0.88 0.005 70);
    --chip-grey-bg: oklch(0.96 0.003 70);    --chip-grey-br: oklch(0.9 0.006 70);    --chip-grey-fg: oklch(0.6 0.01 60);
    --chip-blue-bg: oklch(0.96 0.03 250);    --chip-blue-br: oklch(0.88 0.05 250);   --chip-blue-fg: oklch(0.45 0.1 250);
    --chip-violet-bg: oklch(0.97 0.02 300);  --chip-violet-br: oklch(0.9 0.04 300);  --chip-violet-fg: oklch(0.47 0.1 300);
    --chip-faint-bg: oklch(0.98 0.002 70);   --chip-faint-br: oklch(0.92 0.006 70);  --chip-faint-fg: oklch(0.62 0.01 60);
  }

  @media (prefers-color-scheme: dark) {
    :root {
      color-scheme: dark;
      --bg: oklch(0.19 0.006 70);
      --fg: oklch(0.91 0.006 70);
      --surface: oklch(0.235 0.006 70);
      --border: oklch(0.32 0.008 70);
      --border-soft: oklch(0.28 0.007 70);
      --border-head: oklch(0.31 0.008 70);
      --muted: oklch(0.66 0.008 70);
      --muted-2: oklch(0.6 0.008 70);
      --muted-3: oklch(0.63 0.008 70);
      --cell: oklch(0.78 0.008 70);
      --link: oklch(0.76 0.1 250);
      --link-hover: oklch(0.84 0.11 250);
      --accent: oklch(0.7 0.12 250);
      --tab-on-fg: oklch(0.85 0.07 250);
      --tab-hover-fg: oklch(0.86 0.008 70);
      --badge-bg: oklch(0.3 0.006 70);
      --badge-fg: oklch(0.7 0.008 70);
      --badge-on-bg: oklch(0.33 0.06 250);
      --badge-on-fg: oklch(0.83 0.09 250);
      --btn-bg: oklch(0.28 0.007 70);
      --btn-border: oklch(0.38 0.009 70);
      --btn-fg: oklch(0.88 0.006 70);
      --btn-hover-bg: oklch(0.33 0.008 70);
      --row-hover: oklch(0.28 0.008 70);
      --tag-bg: oklch(0.28 0.006 70);
      --tag-border: oklch(0.35 0.008 70);
      --tag-fg: oklch(0.72 0.008 70);
      --err-bg: oklch(0.27 0.05 25);
      --err-border: oklch(0.44 0.1 25);
      --err-fg: oklch(0.83 0.11 25);
      --hero-bg: oklch(0.255 0.025 250);
      --hero-border: oklch(0.4 0.06 250);
      --track: oklch(0.3 0.006 70);
      --track-fill: oklch(0.68 0.14 150);
      --win-fg: oklch(0.79 0.13 150);
      --quick-fg: oklch(0.77 0.12 150);

      --row: oklch(0.235 0.006 70);
      --row-settled: oklch(0.215 0.005 70);
      --state-them-bg: oklch(0.31 0.05 250);   --state-them-fg: oklch(0.82 0.09 250);
      --state-done-bg: oklch(0.29 0.005 70);   --state-done-fg: oklch(0.72 0.008 70);
      --state-yours-bg: oklch(0.33 0.06 85);   --state-yours-fg: oklch(0.87 0.1 85);
      --state-todo-bg: oklch(0.32 0.07 25);    --state-todo-fg: oklch(0.85 0.1 25);
      --age-idle-bar: oklch(0.38 0.006 70);    --age-idle-fg: oklch(0.62 0.008 70);
      --age-stale-bar: oklch(0.62 0.18 25);    --age-stale-fg: oklch(0.75 0.15 25);
      --age-hot-bar: oklch(0.7 0.16 45);       --age-hot-fg: oklch(0.8 0.13 45);
      --age-warn-bar: oklch(0.8 0.14 85);      --age-warn-fg: oklch(0.85 0.12 85);
      --age-fresh-bar: oklch(0.72 0.14 150);   --age-fresh-fg: oklch(0.8 0.12 150);
      --ci-fail: oklch(0.64 0.18 25);
      --ci-pass: oklch(0.72 0.15 150);
      --ci-pending: oklch(0.81 0.13 85);
      --ci-none: oklch(0.42 0.006 70);
      --chip-grey-bg: oklch(0.29 0.005 70);    --chip-grey-br: oklch(0.37 0.008 70);   --chip-grey-fg: oklch(0.72 0.008 70);
      --chip-blue-bg: oklch(0.3 0.045 250);    --chip-blue-br: oklch(0.41 0.06 250);   --chip-blue-fg: oklch(0.8 0.09 250);
      --chip-violet-bg: oklch(0.31 0.045 300); --chip-violet-br: oklch(0.41 0.06 300); --chip-violet-fg: oklch(0.81 0.08 300);
      --chip-faint-bg: oklch(0.25 0.004 70);   --chip-faint-br: oklch(0.33 0.006 70);  --chip-faint-fg: oklch(0.64 0.008 70);
    }
  }

  body { margin: 0; background: var(--bg); color: var(--fg);
         font-family: 'IBM Plex Sans', Helvetica, sans-serif; font-size: 14px; -webkit-font-smoothing: antialiased; }
  a { color: var(--link); text-decoration: none; }
  a:hover { color: var(--link-hover); text-decoration: underline; }
  .mono { font-family: 'IBM Plex Mono', monospace; }
  .bar { display: flex; align-items: center; gap: 16px; padding: 14px 24px; background: var(--surface);
         border-bottom: 1px solid var(--border); position: sticky; top: 0; z-index: 5; }
  .btn { font: 500 13px 'IBM Plex Sans', sans-serif; padding: 6px 14px; border: 1px solid var(--btn-border);
         background: var(--btn-bg); border-radius: 6px; cursor: pointer; color: var(--btn-fg); }
  .btn:hover { background: var(--btn-hover-bg); }
  .tabs { display: flex; align-items: stretch; padding: 0 24px; background: var(--surface);
          border-bottom: 1px solid var(--border); }
  .tab { font: 500 13px 'IBM Plex Sans', sans-serif; padding: 11px 14px; display: flex; align-items: center;
         gap: 7px; border-bottom: 2px solid transparent; color: var(--muted); margin-bottom: -1px; }
  .tab:hover { text-decoration: none; color: var(--tab-hover-fg); }
  .tab.on { border-bottom-color: var(--accent); color: var(--tab-on-fg); }
  .badge { font-family: 'IBM Plex Mono', monospace; font-size: 11px; background: var(--badge-bg);
           color: var(--badge-fg); padding: 2px 6px; border-radius: 10px; }
  .tab.on .badge { background: var(--badge-on-bg); color: var(--badge-on-fg); }
  .grid { display: grid; grid-template-columns: <%= cols %>; align-items: center; }
  .head { padding: 9px 24px 9px 20px; font-family: 'IBM Plex Mono', monospace; font-size: 10px;
          letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted-2);
          border-bottom: 1px solid var(--border-head); }
  .row { padding: 11px 24px 11px 20px; border-bottom: 1px solid var(--border-soft); }
  .row:hover { background: var(--row-hover) !important; }
  .pill { font: 500 11px 'IBM Plex Mono', monospace; padding: 3px 7px; border-radius: 4px; white-space: nowrap; }
  .chip { font-size: 10px; font-family: 'IBM Plex Mono', monospace; padding: 2px 6px; border-radius: 3px; border: 1px solid; }
  .title { font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .sub { font-size: 11px; color: var(--muted-3); font-family: 'IBM Plex Mono', monospace; margin-top: 2px; }
  /* padding-right is the gutter: without it a full-width cell runs straight
     into the next column and reads as one word ("pushreview"). min-width and
     the ellipsis keep a long login on one line instead of wrapping. */
  .cell { font-size: 12px; color: var(--cell); min-width: 0; padding-right: 14px; }
  .cell > div { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .dot { width: 7px; height: 7px; border-radius: 50%; flex: none; display: inline-block; }
  .mini { font: 500 11px 'IBM Plex Mono', monospace; padding: 4px 9px; border-radius: 5px;
          border: 1px solid var(--btn-border); background: var(--btn-bg); color: var(--muted);
          cursor: pointer; opacity: 0.35; transition: opacity 120ms ease; }
  .row:hover .mini, .hero .mini { opacity: 1; }
  .mini:hover { background: var(--btn-hover-bg); color: var(--fg); }

  /* progress: how much of this view is already dealt with */
  .track { height: 4px; background: var(--track); border-radius: 2px; overflow: hidden; flex: 1; }
  .fill { height: 100%; background: var(--track-fill); border-radius: 2px; transition: width 400ms ease; }

  /* hero: the single next thing to review */
  .hero { margin: 16px 24px 4px; padding: 14px 18px; background: var(--hero-bg);
          border: 1px solid var(--hero-border); border-radius: 10px;
          display: flex; align-items: center; gap: 16px; }
  .hero-label { font: 600 10px 'IBM Plex Mono', monospace; letter-spacing: 0.1em;
                text-transform: uppercase; color: var(--muted-2); }
  .go { font: 600 13px 'IBM Plex Sans', sans-serif; padding: 8px 16px; border-radius: 7px;
        background: var(--accent); color: var(--surface); white-space: nowrap; }
  .go:hover { text-decoration: none; color: var(--surface); filter: brightness(1.08); }

  .win { padding: 72px 24px; text-align: center; animation: pop 420ms ease-out; }
  .win-mark { font-size: 40px; line-height: 1; animation: bob 2.6s ease-in-out infinite; }
  .win-head { margin-top: 14px; font-weight: 600; font-size: 20px; color: var(--win-fg); }
  @keyframes pop { from { opacity: 0; transform: scale(0.94); } to { opacity: 1; transform: none; } }
  @keyframes bob { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-6px); } }
  @media (prefers-reduced-motion: reduce) {
    .win, .win-mark { animation: none; }
    .fill { transition: none; }
  }
</style>
</head>
<body>

<div class="bar">
  <div style="font-weight: 600; font-size: 15px; letter-spacing: -0.01em;">Review queue</div>
  <div class="mono" style="font-size: 12px; color: var(--tag-fg); background: var(--tag-bg);
       border: 1px solid var(--tag-border); padding: 3px 8px; border-radius: 4px;">
    <%= service.scope %>
  </div>
  <form method="post" action="/settings?tab=<%= tab %><%= hide ? "&hide=1" : "" %>"
        style="margin: 0; display: flex; align-items: center; gap: 6px;">
    <%== csrf_settings %>
    <label class="mono" for="label" style="font-size: 11px; color: var(--muted-2);">watch label</label>
    <input class="mono" id="label" name="label" value="<%= service.label %>" maxlength="64"
           placeholder="<%= suggested_label.empty? ? "none" : suggested_label %>"
           title="Show every open PR with this label, even when nobody asked you. Leave empty to watch nothing."
           style="font-size: 12px; width: 108px; padding: 4px 8px; border-radius: 5px;
                  border: 1px solid var(--btn-border); background: var(--btn-bg); color: var(--fg);" />
    <button class="mini" type="submit">Set</button>
  </form>
  <div style="flex: 1;"></div>
  <div class="mono" style="font-size: 11px; color: var(--muted-2);">
    <% meta = [] %>
    <% meta << "@#{login}" if login %>
    <% if reviews_7d %>
      <% meta << "#{reviews_7d[:count]}#{reviews_7d[:complete] ? "" : "+"} reviewed this week" %>
    <% end %>
    <% meta << "updated #{service.send(:ago, snap[:fetched_at])} ago" if snap[:fetched_at] %>
    <% meta << "#{snap[:rate]} api calls left" if snap[:rate] %>
    <%= meta.join("  ·  ") %>
  </div>
  <form method="post" action="/refresh?tab=<%= tab %><%= hide ? "&hide=1" : "" %>" style="margin: 0;">
    <%== csrf %>
    <button class="btn" type="submit">Refresh</button>
  </form>
  <form method="post" action="/logout" style="margin: 0;">
    <%== csrf_logout %>
    <button class="btn" type="submit">Sign out</button>
  </form>
</div>

<div class="tabs">
  <% tabs.each do |t| %>
    <% c = counts[t[:key]] || {open: 0, total: 0} %>
    <a class="tab <%= "on" if tab == t[:key] %>" href="<%= qs.call(t[:key], hide) %>">
      <span><%= t[:label] %></span>
      <span class="badge"><%= c[:open] %>/<%= c[:total] %></span>
    </a>
  <% end %>
  <div style="flex: 1;"></div>
  <a class="tab" href="<%= qs.call(tab, !hide) %>" style="color: var(--muted);">
    <%= hide ? "Show settled" : "Hide settled" %>
  </a>
</div>

<% unless total.zero? && drafts.zero? %>
  <div style="display: flex; align-items: center; gap: 12px; padding: 10px 24px 0;">
    <div class="mono" style="font-size: 11px; color: var(--muted-2); white-space: nowrap;">
      <%= active %> to go<%= done.positive? ? " · #{done} done" : "" %><%= drafts.positive? ? " · #{drafts} draft" : "" %>
    </div>
    <div class="track"><div class="fill" style="width: <%= pct %>%;"></div></div>
    <div class="mono" style="font-size: 11px; color: var(--muted-2);"><%= pct %>%</div>
  </div>
<% end %>

<% if snap[:error] %>
  <div class="mono" style="margin: 24px; padding: 12px 16px; border: 1px solid var(--err-border);
       background: var(--err-bg); border-radius: 8px; font-size: 12px; color: var(--err-fg);">
    <%= snap[:error] %>
  </div>
<% end %>

<% if hero %>
  <div class="hero">
    <div style="min-width: 0; flex: 1;">
      <div class="hero-label">Next up<%= hero[:quick] ? " · quick win" : "" %></div>
      <div style="display: flex; align-items: baseline; gap: 8px; margin-top: 5px;">
        <a class="title" href="<%= hero[:url] %>" target="_blank" rel="noreferrer"
           style="font-size: 15px;"><%= hero[:title] %></a>
        <span class="mono" style="font-size: 11px; color: var(--muted-3); flex: none;"><%= hero[:ref] %></span>
      </div>
      <div class="mono" style="font-size: 11px; color: var(--muted); margin-top: 6px;">
        <%= hero[:read_est] %> read · <%= hero[:size_sub] %> · waiting <%= hero[:age] %> · <%= hero[:author] %>
      </div>
    </div>
    <span class="pill" style="background: <%= hero[:state_bg] %>; color: <%= hero[:state_color] %>;"><%= hero[:state] %></span>
    <form method="post" action="/snooze?tab=<%= tab %><%= hide ? "&hide=1" : "" %>" style="margin: 0;">
      <%== csrf_snooze %>
      <input type="hidden" name="key" value="<%= hero[:key] %>" />
      <button class="mini" type="submit" title="Hide until there is new activity">Not now</button>
    </form>
    <a class="go" href="<%= hero[:url] %>" target="_blank" rel="noreferrer">Review it →</a>
  </div>
<% end %>

<div style="padding-bottom: 80px;">
  <div class="grid head">
    <div></div><div>State</div><div>Pull request</div><div>Size</div><div>Last activity</div>
    <div>My last action</div><div>CI</div><div style="text-align: right;">Waiting</div><div></div>
  </div>

  <% rows.each do |r| %>
    <div class="grid row" style="background: <%= r[:row_bg] %>;">
      <div style="width: 4px; height: 30px; border-radius: 2px; background: <%= r[:age_color] %>;"></div>
      <div style="padding-left: 12px;">
        <span class="pill" style="background: <%= r[:state_bg] %>; color: <%= r[:state_color] %>;"><%= r[:state] %></span>
      </div>
      <div style="min-width: 0; padding-right: 24px;">
        <div style="display: flex; align-items: baseline; gap: 8px;">
          <a class="title" href="<%= r[:url] %>" target="_blank" rel="noreferrer"><%= r[:title] %></a>
          <span class="mono" style="font-size: 11px; color: var(--muted-3); flex: none;"><%= r[:ref] %></span>
        </div>
        <div style="display: flex; align-items: center; gap: 8px; margin-top: 4px; flex-wrap: wrap;">
          <span class="mono" style="font-size: 11px; color: var(--muted);"><%= r[:author] %></span>
          <% r[:chips].each do |c| %>
            <span class="chip" style="background: <%= c[:bg] %>; border-color: <%= c[:border] %>; color: <%= c[:color] %>;"><%= c[:text] %></span>
          <% end %>
        </div>
      </div>
      <div class="cell">
        <div class="mono" style="font-weight: 500; color: <%= r[:quick] ? "var(--quick-fg)" : "var(--cell)" %>;"><%= r[:read_est] %></div>
        <div class="sub"><%= r[:size_sub] %></div>
      </div>
      <div class="cell">
        <div><%= r[:last_activity] %></div>
        <div class="sub" title="<%= r[:last_actor] %>"><%= r[:last_actor] %></div>
      </div>
      <div class="cell">
        <div><%= r[:my_action] %></div>
        <div class="sub" title="<%= r[:my_action_kind] %>"><%= r[:my_action_kind] %></div>
      </div>
      <div class="cell" style="display: flex; align-items: center; gap: 6px;">
        <span class="dot" style="background: <%= r[:ci_color] %>;"></span>
        <span class="mono" style="font-size: 11px;"><%= r[:ci] %></span>
      </div>
      <div class="mono" style="text-align: right; font-weight: 500; font-size: 13px; color: <%= r[:age_text_color] %>;"><%= r[:age] %></div>
      <div style="text-align: right;">
        <% if snoozing %>
          <form method="post" action="/unsnooze?tab=<%= tab %><%= hide ? "&hide=1" : "" %>" style="margin: 0;">
            <%== csrf_unsnooze %>
            <input type="hidden" name="key" value="<%= r[:key] %>" />
            <button class="mini" type="submit" title="Put this back in the queue now">Wake</button>
          </form>
        <% else %>
          <form method="post" action="/snooze?tab=<%= tab %><%= hide ? "&hide=1" : "" %>" style="margin: 0;">
            <%== csrf_snooze %>
            <input type="hidden" name="key" value="<%= r[:key] %>" />
            <button class="mini" type="submit" title="Hide until there is new activity">Snooze</button>
          </form>
        <% end %>
      </div>
    </div>
  <% end %>

  <% if snoozing && rows.empty? %>
    <div style="padding: 72px 24px; text-align: center; color: var(--muted-2); font-size: 13px;">
      Nothing is snoozed. Use <span class="mono">Snooze</span> on a row to hide it until
      there is new activity on it.
    </div>
  <% elsif active.zero? && !snoozing %>
    <div class="win">
      <div class="win-mark">🎉</div>
      <div class="win-head">
        <%= total.zero? && drafts.zero? ? "Nothing in the queue." : "Queue clear — nothing waiting on you." %>
      </div>
      <div class="mono" style="margin-top: 8px; font-size: 12px; color: var(--muted-2);">
        <% if reviews_7d && reviews_7d[:count].positive? %>
          <%= reviews_7d[:count] %><%= reviews_7d[:complete] ? "" : "+" %>
          <%= reviews_7d[:count] == 1 ? "pull request" : "pull requests" %> reviewed in the last 7 days<%= done.positive? ? " · #{done} settled here" : "" %>
        <% else %>
          <%= hide ? "Nothing waiting on you." : "No open pull requests matched." %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>

</body>
</html>
