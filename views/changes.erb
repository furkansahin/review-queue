<%
  summary = begin
    job["summary"].to_s.empty? ? nil : JSON.parse(job["summary"])
  rescue JSON::ParserError
    nil
  end
  running = %w[queued running].include?(job["state"])
  can_write = baybox && !baybox["github_write_token_enc"].to_s.empty?
  issue_url = "https://github.com/#{job["repo"]}/issues/#{job["pr_number"]}"
  # One view for the whole branch, then one per commit, in the order they were
  # made -- the order a reviewer reads a branch that was split on purpose.
  views = []
  if diff
    views << {key: "branch", label: "All changes", files: DiffView.parse(diff[:branch].to_s)}
    Array(diff[:commits]).each do |c|
      views << {key: c[:sha], label: c[:subject], sha: c[:sha].to_s[0, 7], body: c[:body], files: DiffView.parse(c[:patch].to_s)}
    end
  end
  whole = views.first
  adds = whole ? whole[:files].sum(&:additions) : 0
  dels = whole ? whole[:files].sum(&:deletions) : 0
  status_word = {added: "new", deleted: "deleted", renamed: "renamed", modified: "changed"}
  pill = {"queued" => ["var(--state-them-bg)", "var(--state-them-fg)"],
          "running" => ["var(--state-yours-bg)", "var(--state-yours-fg)"],
          "done" => ["var(--chip-blue-bg)", "var(--chip-blue-fg)"],
          "failed" => ["var(--state-todo-bg)", "var(--state-todo-fg)"]}.fetch(job["state"], ["var(--chip-grey-bg)", "var(--chip-grey-fg)"])
  title = (summary && summary["title"]).to_s
%>
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Changes · #<%= job["pr_number"] %> · Review queue</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="" />
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
<style>
<%= PALETTE %>
  :root {
    --diff-add-bg: oklch(0.96 0.04 150);  --diff-add-no: oklch(0.92 0.06 150);
    --diff-del-bg: oklch(0.96 0.03 25);   --diff-del-no: oklch(0.92 0.05 25);
    --diff-hunk-bg: oklch(0.955 0.02 250);
    --comment-bg: oklch(0.975 0.02 85);   --comment-br: oklch(0.88 0.06 85);
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --diff-add-bg: oklch(0.27 0.045 150); --diff-add-no: oklch(0.31 0.06 150);
      --diff-del-bg: oklch(0.27 0.04 25);   --diff-del-no: oklch(0.31 0.05 25);
      --diff-hunk-bg: oklch(0.26 0.02 250);
      --comment-bg: oklch(0.26 0.03 85);    --comment-br: oklch(0.38 0.06 85);
    }
  }
  body { margin: 0; background: var(--bg); color: var(--fg);
         font-family: 'IBM Plex Sans', Helvetica, sans-serif; font-size: 14px; -webkit-font-smoothing: antialiased; }
  a { color: var(--link); text-decoration: none; }
  a:hover { color: var(--link-hover); text-decoration: underline; }
  .mono { font-family: 'IBM Plex Mono', monospace; }
  .bar { display: flex; align-items: center; gap: 16px; padding: 14px 24px; background: var(--surface);
         border-bottom: 1px solid var(--border); }
  .wrap { padding: 20px 24px 180px; max-width: 1400px; }
  .card { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 14px 16px; margin-bottom: 14px; }
  .row1 { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .sub { font-size: 11px; color: var(--muted-3); font-family: 'IBM Plex Mono', monospace; margin-top: 6px; }
  .pill { font: 500 11px 'IBM Plex Mono', monospace; padding: 3px 7px; border-radius: 4px; white-space: nowrap; }
  .mini { font: 500 11px 'IBM Plex Mono', monospace; padding: 4px 9px; border-radius: 5px;
          border: 1px solid var(--btn-border); background: var(--btn-bg); color: var(--muted); cursor: pointer; }
  .mini:hover { color: var(--fg); background: var(--btn-hover-bg); }
  .warn { color: var(--err-fg); font-family: 'IBM Plex Mono', monospace; font-size: 12px; }
  .banner { padding: 10px 14px; border-radius: 8px; font-size: 12px; margin-bottom: 14px; font-family: 'IBM Plex Mono', monospace; }
  details > summary { cursor: pointer; }
  .md { font-family: 'IBM Plex Mono', monospace; font-size: 12.5px; line-height: 1.6; }
  .md p { margin: 8px 0; }
  .md code { color: var(--tok-lit); }
  .tabs { display: flex; gap: 6px; flex-wrap: wrap; margin: 4px 0 12px; }
  .tab { font: 500 12px 'IBM Plex Sans', sans-serif; padding: 6px 10px; border-radius: 6px; cursor: pointer;
         border: 1px solid var(--border); background: var(--surface); color: var(--muted); max-width: 420px;
         overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .tab .mono { font-size: 11px; color: var(--muted-3); margin-right: 6px; }
  .tab.on { border-color: var(--accent); color: var(--tab-on-fg); }
  .files { font-family: 'IBM Plex Mono', monospace; font-size: 12px; margin: 0 0 12px; padding: 0; list-style: none; }
  .files li { margin: 2px 0; }
  .plus { color: var(--tok-add); } .minus { color: var(--tok-del); }
  .file { background: var(--surface); border: 1px solid var(--border); border-radius: 8px; margin-bottom: 12px; overflow: hidden; }
  .file > summary { padding: 8px 12px; font-family: 'IBM Plex Mono', monospace; font-size: 12px;
                    border-bottom: 1px solid var(--border-soft); background: var(--surface); }
  .diffscroll { overflow-x: auto; }
  table.diff { border-collapse: collapse; width: 100%; font-family: 'IBM Plex Mono', monospace; font-size: 12px; line-height: 1.55; }
  table.diff td { padding: 0 8px; vertical-align: top; }
  td.no { color: var(--muted-3); text-align: right; width: 1%; white-space: nowrap; user-select: none; }
  td.gut { width: 1%; padding: 0 2px 0 6px; }
  td.code { white-space: pre; width: 100%; }
  .mark { color: var(--muted-3); user-select: none; display: inline-block; width: 1.2em; }
  tr.add td.code, tr.add td.gut { background: var(--diff-add-bg); } tr.add td.no { background: var(--diff-add-no); }
  tr.del td.code, tr.del td.gut { background: var(--diff-del-bg); } tr.del td.no { background: var(--diff-del-no); }
  tr.hunk td { background: var(--diff-hunk-bg); color: var(--muted); padding: 3px 8px; }
  tr.note td { color: var(--muted-3); font-style: italic; }
  button.cmt { visibility: hidden; font: 600 12px 'IBM Plex Mono', monospace; width: 18px; height: 18px; line-height: 14px;
               padding: 0; border-radius: 4px; border: 1px solid var(--accent); background: var(--accent); color: var(--bg); cursor: pointer; }
  tr.ln:hover button.cmt, button.cmt:focus { visibility: visible; }
  tr.comment td, tr.editor td { padding: 6px 12px 8px 40px; }
  .cbox { background: var(--comment-bg); border: 1px solid var(--comment-br); border-radius: 6px; padding: 8px 10px;
          font-family: 'IBM Plex Sans', sans-serif; font-size: 13px; white-space: pre-wrap; max-width: 820px; }
  .cbox .acts { margin-top: 6px; display: flex; gap: 6px; }
  textarea { font-family: 'IBM Plex Mono', monospace; font-size: 12px; padding: 8px 10px; border-radius: 6px; width: 100%;
             box-sizing: border-box; border: 1px solid var(--btn-border); background: var(--btn-bg); color: var(--fg); resize: vertical; }
  .tok .k, .tok .kd, .tok .kn, .tok .kp, .tok .kr, .tok .kt { color: var(--tok-key); }
  .tok .s, .tok .s1, .tok .s2, .tok .sb, .tok .sd, .tok .se, .tok .si, .tok .sx, .tok .ss { color: var(--tok-str); }
  .tok .c, .tok .c1, .tok .cm, .tok .cs { color: var(--tok-com); font-style: italic; }
  .tok .m, .tok .mi, .tok .mf, .tok .mh, .tok .il { color: var(--tok-num); }
  .tok .nf, .tok .nc, .tok .nn { color: var(--tok-fn); }
  .tok .nb, .tok .bp, .tok .no, .tok .nv, .tok .vi, .tok .vc, .tok .vg { color: var(--tok-var); }
  .panel { position: fixed; left: 0; right: 0; bottom: 0; background: var(--surface); border-top: 1px solid var(--border);
           padding: 10px 24px; box-shadow: 0 -4px 16px oklch(0 0 0 / 0.08); }
  .panel .line { display: flex; gap: 10px; align-items: flex-start; max-width: 1400px; }
  .panel textarea { flex: 1; min-height: 38px; }
  .panel .count { font-family: 'IBM Plex Mono', monospace; font-size: 12px; color: var(--muted); min-width: 180px; padding-top: 8px; }
  .panel .status { font-family: 'IBM Plex Mono', monospace; font-size: 11px; color: var(--muted-2); margin-top: 6px; }
  .panel .status.err { color: var(--err-fg); }
  .outdated { font-family: 'IBM Plex Mono', monospace; font-size: 11px; color: var(--muted); margin-top: 6px; max-height: 110px; overflow-y: auto; }
</style>
</head>
<body>
<div class="bar">
  <div style="font-weight: 600; font-size: 15px; letter-spacing: -0.01em;">Changes</div>
  <a class="mono" style="font-size: 12px;" href="/sessions">← sessions</a>
  <a class="mono" style="font-size: 12px;" href="/?tab=issues">issues</a>
  <div style="flex: 1;"></div>
  <div class="mono" style="font-size: 11px; color: var(--muted-2);">@<%= login %></div>
</div>

<div class="wrap">
  <% if notice %>
    <div class="banner" style="background: var(--chip-blue-bg); border: 1px solid var(--chip-blue-br); color: var(--chip-blue-fg);"><%= notice %></div>
  <% end %>
  <% if error %>
    <div class="banner" style="background: var(--err-bg); border: 1px solid var(--err-border); color: var(--err-fg);"><%= error %></div>
  <% end %>

  <div class="card">
    <div class="row1">
      <span class="pill" style="background: <%= pill[0] %>; color: <%= pill[1] %>;"><%= job["state"] %></span>
      <span style="font-weight: 600; font-size: 15px;"><%= title.empty? ? "Issue ##{job["pr_number"]}" : title %></span>
      <a class="mono" style="font-size: 12px;" href="<%= issue_url %>" target="_blank" rel="noreferrer"><%= job["repo"] %> #<%= job["pr_number"] %> ↗</a>
      <% if job["pr_url"] %><a class="mono" style="font-size: 12px;" href="<%= job["pr_url"] %>" target="_blank" rel="noreferrer">the pull request ↗</a><% end %>
      <div style="flex: 1;"></div>
      <% if job["state"] == "done" && summary && summary["ahead"].to_i.positive? %>
        <% if can_write %>
          <form method="post" action="/sessions/publish" style="margin: 0;">
            <%== csrf_publish %>
            <input type="hidden" name="id" value="<%= job["id"] %>" />
            <button class="mini" type="submit"><%= job["pr_url"] ? "Push changes" : "Open draft PR" %></button>
          </form>
        <% else %>
          <a class="mono" style="font-size: 11px;" href="/baybox">add a write token to open a PR</a>
        <% end %>
      <% end %>
      <% if job["torn_down_at"].nil? && !running %>
        <form method="post" action="/sessions/changes/refresh" style="margin: 0;">
          <%== csrf_refresh %>
          <input type="hidden" name="id" value="<%= job["id"] %>" />
          <button class="mini" type="submit" title="read the branch again from the box">Read again</button>
        </form>
      <% end %>
    </div>
    <div class="sub">
      branch <strong><%= job["branch"] || "—" %></strong>
      <% if whole %> · <%= views.size - 1 %> commit<%= views.size == 2 ? "" : "s" %> · <span class="plus">+<%= adds %></span> <span class="minus">−<%= dels %></span> · <%= whole[:files].size %> file<%= whole[:files].size == 1 ? "" : "s" %><% end %>
      <% if diff && diff[:head] %> · at <%= diff[:head].to_s[0, 10] %><% end %>
    </div>
    <% if summary && summary["touches_ci"] %><div class="warn" style="margin-top: 8px;">changes .github/ — CI runs this branch with the repository's secrets; read it first</div><% end %>
    <% if summary && summary["dirty"].to_i.positive? %>
      <div class="sub">not included, uncommitted in the box: <%= Array(summary["dirty_files"]).first(5).join(", ") %></div>
    <% end %>
    <% if running %>
      <div class="sub" style="color: var(--state-yours-fg);">Claude is working on this branch. <a href="/sessions#job-<%= job["id"] %>">Follow it live</a> — this page updates when it finishes.</div>
    <% end %>
    <% if diff && diff[:truncated] %><div class="warn" style="margin-top: 8px;">This branch's diff is over the size kept here, so it is cut short.</div><% end %>
    <% if summary && summary["title"] %>
      <details style="margin-top: 10px;" open>
        <summary class="mono" style="font-size: 12px; color: var(--muted);">pull request description</summary>
        <div class="md"><%== Markdown.render(summary["body"].to_s) %></div>
      </details>
    <% end %>
  </div>

  <% if views.empty? %>
    <div class="card"><div class="sub" style="margin: 0;">
      <%= running ? "Nothing to show until this run finishes." : "No diff recorded for this session." %>
    </div></div>
  <% else %>
    <div class="tabs">
      <% views.each do |v| %>
        <button type="button" class="tab<%= v[:key] == "branch" ? " on" : "" %>" data-show="<%= v[:key] %>"
                title="<%= v[:label] %>"><% if v[:sha] %><span class="mono"><%= v[:sha] %></span><% end %><%= v[:label] %></button>
      <% end %>
    </div>

    <% views.each do |v| %>
      <section class="view" data-view="<%= v[:key] %>" <%= v[:key] == "branch" ? "" : "hidden" %>>
        <% if v[:sha] %>
          <div class="card" style="padding: 10px 14px;">
            <div style="font-weight: 600;"><%= v[:label] %></div>
            <% unless v[:body].to_s.empty? %><pre class="mono" style="font-size: 12px; white-space: pre-wrap; margin: 8px 0 0;"><%= v[:body] %></pre><% end %>
          </div>
        <% end %>
        <ul class="files">
          <% v[:files].each_with_index do |f, fi| %>
            <li><a href="#<%= v[:key] %>-f<%= fi %>"><%= f.path %></a> <span class="plus">+<%= f.additions %></span> <span class="minus">−<%= f.deletions %></span> <span style="color: var(--muted-3);"><%= status_word[f.status] %></span></li>
          <% end %>
        </ul>
        <% v[:files].each_with_index do |f, fi| %>
          <details class="file" open id="<%= v[:key] %>-f<%= fi %>" data-path="<%= f.path %>">
            <summary>
              <%= f.status == :renamed ? "#{f.old_path} → #{f.new_path}" : f.path %>
              <span class="plus">+<%= f.additions %></span> <span class="minus">−<%= f.deletions %></span>
              <span style="color: var(--muted-3);"><%= status_word[f.status] %></span>
            </summary>
            <% if f.binary %>
              <div class="sub" style="padding: 8px 12px; margin: 0;">binary file</div>
            <% elsif f.hunks.empty? %>
              <div class="sub" style="padding: 8px 12px; margin: 0;">no content changes</div>
            <% else %>
              <div class="diffscroll"><table class="diff tok">
                <% f.hunks.each do |h| %>
                  <tr class="hunk"><td colspan="4"><%= h.header %></td></tr>
                  <% h.lines.each do |l| %>
                    <% if l.kind == :note %>
                      <tr class="note"><td colspan="3"></td><td class="code"><%= l.text %></td></tr>
                    <% else %>
                      <% side = l.kind == :del ? "old" : "new" %>
                      <tr class="ln <%= l.kind %>" data-side="<%= side %>" data-line="<%= side == "old" ? l.old_no : l.new_no %>" data-text="<%= l.text %>">
                        <td class="gut"><button class="cmt" type="button" title="comment on this line" aria-label="comment on this line">+</button></td>
                        <td class="no"><%= l.old_no %></td><td class="no"><%= l.new_no %></td>
                        <td class="code"><span class="mark"><%= {add: "+", del: "-", ctx: " "}[l.kind] %></span><%== l.html || CGI.escapeHTML(l.text.to_s) %></td>
                      </tr>
                    <% end %>
                  <% end %>
                <% end %>
              </table></div>
            <% end %>
          </details>
        <% end %>
      </section>
    <% end %>
  <% end %>
</div>

<% if diff %>
<div class="panel">
  <div class="line">
    <div class="count" id="count">No comments yet — hover a line and press +</div>
    <textarea id="overall" rows="1" maxlength="8000" placeholder="Overall note for Claude (optional). Enter sends the review, Ctrl+Enter adds a line."></textarea>
    <button class="mini" id="send" type="button" style="padding: 8px 12px;">Send review to Claude</button>
  </div>
  <div class="status" id="status"><%= running ? "Claude is still working on this branch; send when it has finished." : "" %></div>
  <div class="outdated" id="outdated" hidden></div>
</div>
<% end %>

<script>
(function () {
  var JOB = <%= job["id"].to_i %>;
  var HEAD = <%== JSON.generate((diff && diff[:head]).to_s) %>;
  var RUNNING = <%= running ? "true" : "false" %>;
  var TOKEN = <%== JSON.generate(review_token.to_s) %>;
  var KEY = "rq-review-" + JOB;

  // The views: the whole branch, or one commit.
  document.querySelectorAll("[data-show]").forEach(function (b) {
    b.addEventListener("click", function () {
      document.querySelectorAll("section.view").forEach(function (s) { s.hidden = s.dataset.view !== b.dataset.show; });
      document.querySelectorAll(".tab").forEach(function (t) { t.classList.toggle("on", t === b); });
    });
  });

  if (!document.getElementById("send")) return;

  // Comments live in this browser until they are sent, so a reload -- or the
  // page coming back after a run -- does not lose them.
  var comments = [];
  var sending = false;
  try { comments = JSON.parse(localStorage.getItem(KEY) || "[]"); } catch (e) { comments = []; }
  var overall = document.getElementById("overall");
  try { overall.value = localStorage.getItem(KEY + "-overall") || ""; } catch (e) { /* blocked */ }
  function persist() {
    try {
      localStorage.setItem(KEY, JSON.stringify(comments));
      localStorage.setItem(KEY + "-overall", overall.value);
    } catch (e) { /* full or blocked */ }
    refresh();
  }
  overall.addEventListener("input", persist);

  function rowFor(c) {
    var sec = document.querySelector('section.view[data-view="' + CSS.escape(c.view) + '"]');
    if (!sec) return null;
    var file = Array.prototype.find.call(sec.querySelectorAll("details.file"), function (d) { return d.dataset.path === c.path; });
    if (!file) return null;
    var row = file.querySelector('tr.ln[data-side="' + c.side + '"][data-line="' + c.line + '"]');
    // Only where the line still reads the same: after a follow-up the same
    // number can hold different code.
    return row && row.dataset.text === c.text ? row : null;
  }
  function anchorOf(row) {
    return { view: row.closest("section.view").dataset.view, path: row.closest("details.file").dataset.path,
             side: row.dataset.side, line: parseInt(row.dataset.line, 10), text: row.dataset.text };
  }
  function afterRow(row) {
    var at = row;
    while (at.nextElementSibling && (at.nextElementSibling.classList.contains("comment") || at.nextElementSibling.classList.contains("editor"))) {
      at = at.nextElementSibling;
    }
    return at;
  }

  // Enter saves (or sends); Ctrl+Enter and Shift+Enter add a line, as in the
  // follow-up box.
  function keys(ta, onSave, onCancel) {
    ta.addEventListener("keydown", function (e) {
      if (e.key === "Escape" && onCancel) { e.preventDefault(); onCancel(); return; }
      if (e.key !== "Enter" || e.isComposing || e.keyCode === 229 || e.shiftKey) return;
      e.preventDefault();
      if (e.ctrlKey) {
        // setRangeText does not enforce maxlength, so hold it here.
        var picked = ta.selectionEnd - ta.selectionStart;
        if (ta.maxLength > 0 && ta.value.length - picked >= ta.maxLength) return;
        ta.setRangeText("\n", ta.selectionStart, ta.selectionEnd, "end");
        return;
      }
      onSave();
    });
  }

  function draw(c) {
    var row = rowFor(c);
    if (!row) return false;
    var tr = document.createElement("tr");
    tr.className = "comment";
    tr.dataset.cid = c.id;
    var td = document.createElement("td");
    td.colSpan = 4;
    var box = document.createElement("div");
    box.className = "cbox";
    var body = document.createElement("div");
    body.textContent = c.body;
    var acts = document.createElement("div");
    acts.className = "acts";
    var edit = document.createElement("button"); edit.type = "button"; edit.className = "mini"; edit.textContent = "Edit";
    var del = document.createElement("button"); del.type = "button"; del.className = "mini"; del.textContent = "Delete";
    edit.addEventListener("click", function () { tr.remove(); editor(row, c); });
    del.addEventListener("click", function () {
      comments = comments.filter(function (x) { return x.id !== c.id; });
      tr.remove();
      persist();
    });
    acts.appendChild(edit); acts.appendChild(del);
    box.appendChild(body); box.appendChild(acts);
    td.appendChild(box); tr.appendChild(td);
    afterRow(row).after(tr);
    return true;
  }

  function editor(row, existing) {
    var tr = document.createElement("tr");
    tr.className = "editor";
    var td = document.createElement("td");
    td.colSpan = 4;
    var ta = document.createElement("textarea");
    ta.rows = 3;
    ta.maxLength = 4000;
    ta.placeholder = "What should change here? Enter saves, Ctrl+Enter adds a line, Esc cancels.";
    ta.value = existing ? existing.body : "";
    var acts = document.createElement("div");
    acts.className = "acts";
    acts.style.marginTop = "6px";
    acts.style.display = "flex";
    acts.style.gap = "6px";
    var save = document.createElement("button"); save.type = "button"; save.className = "mini"; save.textContent = "Save";
    var cancel = document.createElement("button"); cancel.type = "button"; cancel.className = "mini"; cancel.textContent = "Cancel";
    function done() {
      var text = ta.value.trim();
      tr.remove();
      if (existing) {
        if (text) { existing.body = text; } else { comments = comments.filter(function (x) { return x.id !== existing.id; }); }
        persist();
        if (text) draw(existing);
        return;
      }
      if (!text) return;
      var c = anchorOf(row);
      c.id = Date.now().toString(36) + Math.random().toString(36).slice(2, 6);
      c.body = text;
      c.head = HEAD;
      comments.push(c);
      persist();
      draw(c);
    }
    function undo() { tr.remove(); if (existing) draw(existing); }
    save.addEventListener("click", done);
    cancel.addEventListener("click", undo);
    keys(ta, done, undo);
    acts.appendChild(save); acts.appendChild(cancel);
    td.appendChild(ta); td.appendChild(acts); tr.appendChild(td);
    afterRow(row).after(tr);
    ta.focus();
  }

  document.addEventListener("click", function (e) {
    var b = e.target.closest("button.cmt");
    if (b) { editor(b.closest("tr.ln")); }
  });

  // Comments whose line is no longer there as it was still go with the review,
  // listed here rather than under a line that now holds something else.
  function refresh() {
    var anchored = 0, lost = [];
    comments.forEach(function (c) { if (rowFor(c)) { anchored++; } else { lost.push(c); } });
    var n = comments.length;
    document.getElementById("count").textContent =
      n === 0 ? "No comments yet — hover a line and press +" : n + " comment" + (n === 1 ? "" : "s") + (lost.length ? " (" + lost.length + " no longer on the branch as written)" : "");
    var box = document.getElementById("outdated");
    box.hidden = lost.length === 0;
    box.textContent = "";
    lost.forEach(function (c) {
      var d = document.createElement("div");
      d.textContent = c.path + ":" + c.line + " — " + c.body.slice(0, 120) + " ";
      var x = document.createElement("a"); x.href = "#"; x.textContent = "remove";
      x.addEventListener("click", function (e) { e.preventDefault(); comments = comments.filter(function (y) { return y.id !== c.id; }); persist(); });
      d.appendChild(x);
      box.appendChild(d);
    });
    document.getElementById("send").disabled = sending || RUNNING || (n === 0 && !overall.value.trim());
  }

  comments.forEach(draw);
  refresh();
  keys(overall, function () {
    var send = document.getElementById("send");
    if (!send.disabled) send.click();
  });

  document.getElementById("send").addEventListener("click", function () {
    var status = document.getElementById("status");
    var fd = new FormData();
    fd.append("id", JOB);
    fd.append("head", HEAD);
    fd.append("comments", JSON.stringify(comments.map(function (c) {
      return { view: c.view, path: c.path, side: c.side, line: c.line, text: c.text, body: c.body };
    })));
    fd.append("overall", overall.value);
    fd.append("_csrf", TOKEN);
    sending = true;
    this.disabled = true;
    status.className = "status";
    status.textContent = "sending…";
    fetch("/sessions/review-send", { method: "POST", body: fd, headers: { "Accept": "application/json" } })
      .then(function (r) { return r.json(); })
      .then(function (d) {
        if (!d.ok) { throw d.error || "could not send"; }
        try { localStorage.removeItem(KEY); localStorage.removeItem(KEY + "-overall"); } catch (e) { /* blocked */ }
        location.href = d.to;
      })
      .catch(function (err) {
        sending = false;
        status.className = "status err";
        status.textContent = typeof err === "string" ? err : "could not send the review; your comments are kept";
        refresh();
      });
  });

  // While a run is working on the branch, come back when it has finished --
  // unless a comment is half written, which a reload would lose.
  if (RUNNING) {
    (function poll() {
      fetch("/sessions/state?id=" + JOB, { headers: { "Accept": "application/json" }, cache: "no-store" })
        .then(function (r) { return r.json(); })
        .then(function (d) {
          var typing = Array.prototype.some.call(document.querySelectorAll("tr.editor textarea"), function (t) { return t.value.trim(); });
          if (d.done && !typing) { location.reload(); return; }
          setTimeout(poll, 5000);
        })
        .catch(function () { setTimeout(poll, 10000); });
    })();
  }
})();
</script>
</body>
</html>
