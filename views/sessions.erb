<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<noscript><meta http-equiv="refresh" content="20" /></noscript>
<title>Sessions · Review queue</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="" />
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
<style>
<%= PALETTE %>
  body { margin: 0; background: var(--bg); color: var(--fg);
         font-family: 'IBM Plex Sans', Helvetica, sans-serif; font-size: 14px; -webkit-font-smoothing: antialiased; }
  a { color: var(--link); text-decoration: none; }
  a:hover { color: var(--link-hover); text-decoration: underline; }
  .mono { font-family: 'IBM Plex Mono', monospace; }
  .bar { display: flex; align-items: center; gap: 16px; padding: 14px 24px; background: var(--surface);
         border-bottom: 1px solid var(--border); }
  .btn { font: 500 13px 'IBM Plex Sans', sans-serif; padding: 6px 14px; border: 1px solid var(--btn-border);
         background: var(--btn-bg); border-radius: 6px; cursor: pointer; color: var(--btn-fg); }
  .btn:hover { background: var(--btn-hover-bg); }
  .mini { font: 500 11px 'IBM Plex Mono', monospace; padding: 4px 9px; border-radius: 5px;
          border: 1px solid var(--btn-border); background: var(--btn-bg); color: var(--muted); cursor: pointer; }
  .mini:hover { color: var(--fg); background: var(--btn-hover-bg); }
  .wrap { padding: 20px 24px 80px; }
  h2 { font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted-2);
       font-family: 'IBM Plex Mono', monospace; font-weight: 600; margin: 26px 0 10px; }
  .card { background: var(--surface); border: 1px solid var(--border); border-radius: 10px;
          padding: 14px 16px; margin-bottom: 10px; }
  .pill { font: 500 11px 'IBM Plex Mono', monospace; padding: 3px 7px; border-radius: 4px; white-space: nowrap; }
  .row1 { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .sub { font-size: 11px; color: var(--muted-3); font-family: 'IBM Plex Mono', monospace; margin-top: 6px; }
  details > summary { cursor: pointer; font-size: 12px; color: var(--muted); margin-top: 10px;
                      font-family: 'IBM Plex Mono', monospace; }
  pre.tail { max-height: 340px; overflow-y: auto; }

  /* A review reads like terminal output, because that is what it is: an agent
     talking through what it found. It is not a document, so nothing here
     changes size -- a heading is bold and coloured at the same size as the
     text under it. What earns colour is the part you scan for: a file path, a
     command, a block of code. */
  .md { font-family: 'IBM Plex Mono', monospace; font-size: 12.5px; line-height: 1.6;
        white-space: normal; }
  .md h3, .md h4, .md h5, .md h6 {
    font-size: 12.5px; font-weight: 600; color: var(--md-head);
    margin: 16px 0 6px; line-height: 1.5; }
  /* The hashes are how it was written, and seeing them keeps the level
     legible without a type scale doing the work. */
  .md h3::before { content: "# "; color: var(--muted-3); }
  .md h4::before { content: "## "; color: var(--muted-3); }
  .md h5::before { content: "### "; color: var(--muted-3); }
  .md h6::before { content: "#### "; color: var(--muted-3); }
  .md p { margin: 8px 0; }
  .md ul { margin: 8px 0; padding-left: 18px; list-style: none; }
  .md li { margin: 3px 0; position: relative; }
  .md li::before { content: "· "; color: var(--muted-3); margin-left: -12px; }
  .md strong { font-weight: 600; color: var(--fg); }
  .md em { font-style: italic; color: var(--muted); }
  /* Inline code is a file path or a symbol nine times in ten. A colour marks
     it; a box around every one of them would fence the prose into squares. */
  .md code { color: var(--tok-lit); }
  .md pre.code { margin: 10px 0; padding: 10px 12px; overflow-x: auto;
                 background: var(--code-bg); border: 1px solid var(--border-soft);
                 border-radius: 6px; }
  .md pre.code code { color: inherit; font-size: 12px; line-height: 1.5; }

  /* Rouge's token classes, mapped onto this page's palette rather than a theme
     of its own, so a code block belongs to the page in both schemes. */
  .md .k, .md .kd, .md .kn, .md .kp, .md .kr, .md .kt { color: var(--tok-key); }
  .md .s, .md .s1, .md .s2, .md .sb, .md .sd, .md .se, .md .si, .md .sx { color: var(--tok-str); }
  .md .c, .md .c1, .md .cm, .md .cs { color: var(--tok-com); font-style: italic; }
  .md .m, .md .mi, .md .mf, .md .mh, .md .il { color: var(--tok-num); }
  .md .nf, .md .nc, .md .nn { color: var(--tok-fn); }
  .md .nb, .md .bp, .md .no, .md .nv, .md .vi { color: var(--tok-var); }
  .md .gd { color: var(--tok-del); }
  .md .gi { color: var(--tok-add); }
  pre { background: var(--bg); border: 1px solid var(--border-soft); border-radius: 8px;
        padding: 12px 14px; overflow-x: auto; font-size: 12px; line-height: 1.5;
        font-family: 'IBM Plex Mono', monospace; white-space: pre-wrap; word-break: break-word; }
  .ask { display: flex; gap: 8px; align-items: flex-end; margin-top: 12px; }
  /* What an issue's branch holds, above the button that pushes it. */
  .branch { margin-top: 12px; padding: 10px 12px; border: 1px solid var(--border-soft);
            border-radius: 8px; background: var(--bg); font-family: 'IBM Plex Mono', monospace;
            font-size: 12px; }
  .branch .line { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .branch .warn { color: var(--err-fg); }
  .branch ul { margin: 6px 0 0; padding-left: 16px; }
  .branch li { margin: 2px 0; }
  .kind { font: 500 10px 'IBM Plex Mono', monospace; padding: 2px 6px; border-radius: 3px;
          border: 1px solid var(--chip-blue-br); background: var(--chip-blue-bg); color: var(--chip-blue-fg); }
  .ask textarea { flex: 1; font-family: 'IBM Plex Mono', monospace; font-size: 12px;
                  padding: 8px 10px; border-radius: 6px; resize: vertical;
                  border: 1px solid var(--btn-border); background: var(--btn-bg); color: var(--fg); }
  .empty { padding: 48px 0; text-align: center; color: var(--muted-2); font-size: 13px; }
  @keyframes pulse { 0%,100% { opacity: 1 } 50% { opacity: 0.45 } }
  .live { animation: pulse 1.6s ease-in-out infinite; }
  @media (prefers-reduced-motion: reduce) { .live { animation: none } }
</style>
</head>
<body>
<%
  colours = {
    "queued"  => ["var(--state-them-bg)",  "var(--state-them-fg)"],
    "running" => ["var(--state-yours-bg)", "var(--state-yours-fg)"],
    "done"    => ["var(--chip-blue-bg)",   "var(--chip-blue-fg)"],
    "failed"  => ["var(--state-todo-bg)",  "var(--state-todo-fg)"]
  }
  live, rest = jobs.partition { |j| %w[queued running].include?(j["state"]) }
  # A torn-down box has no box left to act on, so its card leaves Previous. The
  # review it produced is still worth reading, so it moves rather than vanishes.
  past, gone = rest.partition { |j| j["torn_down_at"].nil? }
  # Newest finished first. A run that ends while the page is open is moved to
  # the top of this list in place (see finish() below), so a reload must put
  # it in the same spot, not wherever its start date falls.
  past = past.sort_by { |j| -(j["finished_at"] || j["created_at"]).to_f }

  # outputs holds only the reviews this page prints; see Jobs.inline_ids. Any
  # other panel is rendered closed with a link, and the script below swaps the
  # text in the first time it is opened.
  chars = ->(j) { j["output_bytes"].to_i }
  has_output = ->(j) { chars.call(j).positive? }
  inline = ->(j) { outputs[j["id"]] }
  # A work session is about an issue, and GitHub's /pull/ path does not
  # redirect for one, so the link has to know.
  gh_link = ->(j) { "https://github.com/#{j["repo"]}/#{j["kind"] == "work" ? "issues" : "pull"}/#{j["pr_number"]}" }
  summary_of = ->(j) {
    begin
      j["summary"].to_s.empty? ? nil : JSON.parse(j["summary"])
    rescue JSON::ParserError
      nil
    end
  }
  can_write = baybox && !baybox["github_write_token_enc"].to_s.empty?
  human = ->(n) {
    if n < 1024 then "#{n} bytes"
    elsif n < 1_048_576 then "#{(n / 1024.0).round} KB"
    else "#{(n / 1_048_576.0).round(1)} MB"
    end
  }
%>
<div class="bar">
  <div style="font-weight: 600; font-size: 15px; letter-spacing: -0.01em;">Sessions</div>
  <a class="mono" style="font-size: 12px;" href="/">← back to the queue</a>
  <div style="flex: 1;"></div>
  <div class="mono" style="font-size: 11px; color: var(--muted-2);">
    @<%= login %><%= baybox ? " · baybox #{baybox["host"]}" : " · no baybox registered" %>
  </div>
</div>

<div class="wrap">
  <% if notice %>
    <div class="mono" style="padding: 10px 14px; border-radius: 8px; font-size: 12px; margin-bottom: 14px;
         background: var(--chip-blue-bg); border: 1px solid var(--chip-blue-br); color: var(--chip-blue-fg);">
      <%= notice %>
    </div>
  <% end %>
  <% if error %>
    <div class="mono" style="padding: 10px 14px; border-radius: 8px; font-size: 12px; margin-bottom: 14px;
         background: var(--err-bg); border: 1px solid var(--err-border); color: var(--err-fg);">
      <%= error %>
    </div>
  <% end %>
  <% unless baybox %>
    <div class="card">
      <strong>No baybox registered.</strong>
      <div class="sub">A review runs on your own baybox. Register one before starting a session.</div>
    </div>
  <% end %>

  <h2 id="active-h">Active<%= live.empty? ? "" : " (#{live.size})" %></h2>
  <div id="active-list">
  <% if live.empty? %>
    <div class="empty">Nothing running. Press <span class="mono">Review</span> on a pull request,
      or <span class="mono">Work on it</span> on an issue.</div>
  <% end %>
  <% live.each do |j| %>
    <% bg, fg = colours.fetch(j["state"], ["var(--chip-grey-bg)", "var(--chip-grey-fg)"]) %>
    <div class="card" id="job-<%= j["id"] %>">
      <div class="row1">
        <span class="pill <%= "live" if j["state"] == "running" %>" style="background: <%= bg %>; color: <%= fg %>;"><%= j["state"] %></span>
        <% if j["kind"] == "work" %><span class="kind" title="claude working on an issue">issue</span><% end %>
        <a href="<%= gh_link.call(j) %>" target="_blank" rel="noreferrer"
           style="font-weight: 500;"><%= j["repo"] %> #<%= j["pr_number"] %></a>
        <span class="mono" style="font-size: 11px; color: var(--muted-3);"><%= j["box_name"] %></span>
        <div style="flex: 1;"></div>
        <form method="post" action="/sessions/cancel" style="margin: 0;">
          <%== csrf_cancel %>
          <input type="hidden" name="id" value="<%= j["id"] %>" />
          <button class="mini" type="submit">Cancel</button>
        </form>
      </div>
      <div class="sub">
        started <%= j["started_at"] || j["created_at"] %>
      </div>
      <% if j["phase"] == "building" && !has_output.call(j) %>
        <div class="sub" style="margin-top: 10px;">
          Preparing the box — worktree, containers, mise, bundle. About 5 minutes on a cold
          machine. Claude's output appears here as soon as it starts.
        </div>
      <% end %>
      <details data-keep="live-<%= j["id"] %>" open>
        <summary>claude output
          <span class="mono" id="s-<%= j["id"] %>" style="color: var(--muted-2);"><%= j["phase"] || "starting" %></span>
        </summary>
        <pre class="tail" id="t-<%= j["id"] %>" data-job="<%= j["id"] %>"><%= inline.call(j) %></pre>
      </details>
    </div>
  <% end %>

  </div>

  <h2 id="previous-h">Previous<%= past.empty? ? "" : " (#{past.size})" %></h2>
  <div id="previous-list">
  <% if past.empty? %>
    <div class="empty">Nothing has finished yet.</div>
  <% end %>
  <% past.each do |j| %>
    <% bg, fg = colours.fetch(j["state"], ["var(--chip-grey-bg)", "var(--chip-grey-fg)"]) %>
    <div class="card" id="job-<%= j["id"] %>">
      <div class="row1">
        <span class="pill" style="background: <%= bg %>; color: <%= fg %>;"><%= j["state"] %></span>
        <% if j["kind"] == "work" %><span class="kind" title="claude working on an issue">issue</span><% end %>
        <a href="<%= gh_link.call(j) %>" target="_blank" rel="noreferrer"
           style="font-weight: 500;"><%= j["repo"] %> #<%= j["pr_number"] %></a>
        <span class="mono" style="font-size: 11px; color: var(--muted-3);"><%= j["box_name"] %></span>
        <div style="flex: 1;"></div>
        <form method="post" action="/sessions/teardown" style="margin: 0;">
          <%== csrf_teardown %>
          <input type="hidden" name="id" value="<%= j["id"] %>" />
          <button class="mini" type="submit" title="bay down --force: free the box's disk">Tear down box</button>
        </form>
      </div>
      <div class="sub">finished <%= j["finished_at"] %><%= j["error"] ? " · #{j["error"]}" : "" %></div>
      <% if has_output.call(j) %>
        <% if (full = inline.call(j)) %>
          <%# One panel per stage, in the order they happened. Only the newest
              answer is open: the rest are there to open, not to scroll past. %>
          <% Transcript.sections(full).each_with_index do |sec, n| %>
            <details data-keep="sec-<%= j["id"] %>-<%= n %>" <%= sec.open ? "open" : "" %>>
              <%# <%== : these are fixed attribute strings. With <%= their quotes were
                  escaped, and the browser read class=&quot;tail&quot; as no tail
                  class at all -- a 200-line trace with no scroll box. %>
              <summary <%== sec.kind == :answer ? "" : 'style="color: var(--muted-2);"' %>><%=
                j["kind"] == "work" ? sec.title.sub("the review", "the work") : sec.title %> <span class="mono" style="font-size: 11px; color: var(--muted-3);"><%=
                sec.kind == :question ? "" : human.call(sec.text.bytesize) %></span></summary>
              <% if sec.dropped %>
                <div class="sub" style="padding: 6px 0 0;">… <%= sec.dropped %> earlier lines not shown</div>
              <% end %>
              <% if sec.kind == :answer %>
                <div class="md"><%== Markdown.render(sec.text) %></div>
              <% else %>
                <pre <%== sec.kind == :trace || sec.kind == :build ? 'class="tail"' : "" %>><%= sec.text %></pre>
              <% end %>
            </details>
          <% end %>
        <% else %>
          <details data-keep="review-<%= j["id"] %>" data-review="<%= j["id"] %>">
            <summary>claude's review (<%= human.call(chars.call(j)) %>) — older, loads when opened</summary>
            <pre><a href="/sessions/review?id=<%= j["id"] %>">open the review</a></pre>
          </details>
        <% end %>
      <% end %>

      <% if j["kind"] == "work" %>
        <% sm = summary_of.call(j) %>
        <div class="branch">
          <div class="line">
            <span>branch <strong><%= j["branch"] || "—" %></strong></span>
            <% if sm %>
              <span><%= sm["ahead"].to_i %> commit<%= sm["ahead"].to_i == 1 ? "" : "s" %></span>
              <% unless sm["stat"].to_s.empty? %><span style="color: var(--muted);"><%= sm["stat"] %></span><% end %>
              <%# Named, and not in red: box setup rewrites files like mise.lock
                  in nearly every box, so this is usually noise. It is shown
                  because it is sometimes work claude forgot to commit, and
                  only the person reading can tell which. %>
              <% if sm["dirty"].to_i.positive? %>
                <% left = Array(sm["dirty_files"]) %>
                <span style="color: var(--muted);" title="a push sends commits only; these stay in the box">not included, uncommitted: <%=
                  left.empty? ? "#{sm["dirty"]} file#{sm["dirty"].to_i == 1 ? "" : "s"}" : left.first(3).join(", ") + (left.size > 3 ? " +#{left.size - 3}" : "") %></span>
              <% end %>
              <%# A branch pushed to the repository runs CI with its secrets, so
                  a change to the workflows is the first thing to read. %>
              <% if sm["touches_ci"] %><span class="warn" title="CI runs this branch with the repository's secrets">changes .github/ — read it first</span><% end %>
            <% else %>
              <span style="color: var(--muted);">not inspected yet</span>
            <% end %>
            <div style="flex: 1;"></div>
            <a href="/sessions/changes?id=<%= j["id"] %>">review the changes →</a>
            <% if j["pr_url"] %>
              <a href="<%= j["pr_url"] %>" target="_blank" rel="noreferrer">the pull request ↗</a>
            <% end %>
            <% if j["state"] == "done" && sm && sm["ahead"].to_i.positive? %>
              <% if can_write %>
                <form method="post" action="/sessions/publish" style="margin: 0;">
                  <%== csrf_publish %>
                  <input type="hidden" name="id" value="<%= j["id"] %>" />
                  <button class="mini" type="submit"
                          title="push <%= j["branch"] %> to GitHub and <%= j["pr_url"] ? "update the pull request" : "open a draft pull request" %>"><%= j["pr_url"] ? "Push changes" : "Open draft PR" %></button>
                </form>
              <% else %>
                <a href="/baybox" title="a token that can push is needed to open a pull request">add a write token to open a PR</a>
              <% end %>
            <% end %>
          </div>
          <% if sm && (sm["commits"].to_a.any? || sm["files"].to_a.any? || sm["title"]) %>
            <details data-keep="branch-<%= j["id"] %>">
              <summary>what it will push</summary>
              <% if sm["title"] %>
                <div style="margin-top: 8px;"><strong><%= sm["title"] %></strong></div>
                <% unless sm["body"].to_s.empty? %><pre style="margin-top: 6px;"><%= sm["body"] %></pre><% end %>
              <% end %>
              <% if sm["commits"].to_a.any? %>
                <ul><% sm["commits"].each do |c| %><li><%= c %></li><% end %></ul>
              <% end %>
              <% if sm["files"].to_a.any? %>
                <ul style="color: var(--muted);"><% sm["files"].first(60).each do |f| %><li class="<%= f.start_with?(".github/") ? "warn" : "" %>"><%= f %></li><% end %></ul>
                <% if sm["files"].size > 60 %><div class="sub">and <%= sm["files"].size - 60 %> more</div><% end %>
              <% end %>
            </details>
          <% end %>
        </div>
      <% end %>

      <form method="post" action="/sessions/ask" class="ask">
        <%== csrf_ask %>
        <input type="hidden" name="id" value="<%= j["id"] %>" />
        <textarea name="prompt" rows="2" maxlength="8192"
                  placeholder="<%= j["kind"] == "work" ? %(Ask for a change in this box — it still has the work in context, e.g. "also cover the nil case, and commit". Enter sends, Ctrl+Enter adds a line.) : %(Ask a follow-up in this box — it still has the review in context, e.g. "show me a failing input for finding 1". Enter sends, Ctrl+Enter adds a line.) %>"></textarea>
        <button class="mini" type="submit" title="or press Enter · Ctrl+Enter adds a line">Send</button>
      </form>
    </div>
  <% end %>
  </div>

  <% unless gone.empty? %>
    <details data-keep="gone-section">
      <summary style="font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase;
                      color: var(--muted-2); font-family: 'IBM Plex Mono', monospace;
                      font-weight: 600; margin: 26px 0 10px; cursor: pointer;">
        Torn down (<%= gone.size %>) — box gone, review kept
      </summary>
      <% gone.each do |j| %>
        <div class="card" style="opacity: 0.75;">
          <div class="row1">
            <span class="pill" style="background: var(--chip-grey-bg); color: var(--chip-grey-fg);">torn down</span>
            <% if j["kind"] == "work" %><span class="kind" title="claude working on an issue">issue</span><% end %>
        <a href="<%= gh_link.call(j) %>" target="_blank" rel="noreferrer"
               style="font-weight: 500;"><%= j["repo"] %> #<%= j["pr_number"] %></a>
            <span class="mono" style="font-size: 11px; color: var(--muted-3);"><%= j["box_name"] %></span>
            <div style="flex: 1;"></div>
            <form method="post" action="/sessions/forget" style="margin: 0;">
              <%== csrf_forget %>
              <input type="hidden" name="id" value="<%= j["id"] %>" />
              <button class="mini" type="submit" title="delete this record and its review text">Forget</button>
            </form>
          </div>
          <div class="sub">box removed <%= j["torn_down_at"] %></div>
          <% if has_output.call(j) %>
            <% if (full = inline.call(j)) %>
              <details data-keep="gonerev-<%= j["id"] %>">
                <summary>claude's review (<%= human.call(full.bytesize) %>)</summary>
                <pre><%= full %></pre>
              </details>
            <% else %>
              <details data-keep="gonerev-<%= j["id"] %>" data-review="<%= j["id"] %>">
                <summary>claude's review (<%= human.call(chars.call(j)) %>) — loads when opened</summary>
                <pre><a href="/sessions/review?id=<%= j["id"] %>">open the review</a></pre>
              </details>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </details>
  <% end %>

  <h2>Boxes on your baybox<%= boxes.empty? ? "" : " (#{boxes.size})" %></h2>
  <div class="sub" style="margin-bottom: 10px;">
    What bay actually has. A box outlives its review and keeps its disk until you tear it down.
  </div>
  <% if boxes.empty? %>
    <div class="empty">No boxes.</div>
  <% end %>
  <% boxes.each do |name, branch, status| %>
    <div class="card">
      <div class="row1">
        <span class="mono" style="font-weight: 500;"><%= name %></span>
        <span class="mono" style="font-size: 11px; color: var(--muted-3);"><%= branch %></span>
        <span class="mono" style="font-size: 11px; color: <%= status.to_s.start_with?("Up") ? "var(--age-fresh-fg)" : "var(--muted-2)" %>;"><%= status %></span>
        <% unless jobs.any? { |j| j["box_name"] == name } %>
          <span class="mono" style="font-size: 11px; color: var(--age-warn-fg);">not from this dashboard</span>
        <% end %>
        <div style="flex: 1;"></div>
        <form method="post" action="/sessions/teardown" style="margin: 0;">
          <%== csrf_teardown %>
          <input type="hidden" name="box" value="<%= name %>" />
          <button class="mini" type="submit" title="bay down --force: free this box's disk">Tear down</button>
        </form>
      </div>
    </div>
  <% end %>
</div>
<script>
// Follows running reviews by asking for bytes after what we already have.
// Short requests, so no Puma thread is held open for the length of a review.
// Without scripting the <noscript> refresh above still updates the page.
// What a card needs wired up: for the cards on the page when it loads, and for
// a finished card put in later without a reload (see finish() below).
var RQ = (function () {
  // Remember which panels are open, so a refresh does not force them all back
  // open. Keyed per job, so it survives the row moving between sections.
  var KEY = "rq-panels";
  var saved;
  try { saved = JSON.parse(localStorage.getItem(KEY) || "{}"); } catch (e) { saved = {}; }

  function keepPanels(root) {
    root.querySelectorAll("details[data-keep]").forEach(function (d) {
      var k = d.dataset.keep;
      if (Object.prototype.hasOwnProperty.call(saved, k)) { d.open = !!saved[k]; }
      d.addEventListener("toggle", function () {
        saved[k] = d.open;
        try { localStorage.setItem(KEY, JSON.stringify(saved)); } catch (e) { /* full or blocked */ }
      });
    });
  }

  // Enter sends a follow-up; Ctrl+Enter starts a new line. So does Shift+Enter,
  // the habit most chat boxes teach, so it never sends by surprise.
  function enterSends(root) {
    root.querySelectorAll("form.ask textarea").forEach(function (ta) {
      ta.addEventListener("keydown", function (e) {
        if (e.key !== "Enter") return;
        // An Enter that confirms an input method's composition is not a send.
        if (e.isComposing || e.keyCode === 229) return;
        if (e.shiftKey) return;                 // the browser adds the line itself
        e.preventDefault();
        if (e.ctrlKey) {
          // Ctrl+Enter adds nothing on its own in a textarea, so add the line
          // here -- within maxlength, which setRangeText does not enforce.
          var picked = ta.selectionEnd - ta.selectionStart;
          if (ta.maxLength > 0 && ta.value.length - picked >= ta.maxLength) return;
          ta.setRangeText("\n", ta.selectionStart, ta.selectionEnd, "end");
          return;
        }
        var form = ta.form;
        // Nothing to send is not a send, and a second Enter while the first is
        // on its way would only earn "wait for the review to finish first".
        if (!ta.value.trim() || form.dataset.sending) return;
        form.dataset.sending = "1";
        if (form.requestSubmit) { form.requestSubmit(); } else { form.submit(); }
      });
    });
  }

  // Older reviews are not printed with the page -- there can be fifty of them
  // at 200 KB each. Each one keeps its size and a plain link, and the first
  // time its panel is opened the text is fetched and swapped in. Without
  // scripting the link is simply followed instead.
  function lazyReviews(root) {
    root.querySelectorAll("details[data-review]").forEach(function (d) {
      var loaded = false;
      d.addEventListener("toggle", function () {
        if (!d.open || loaded) return;
        loaded = true;
        var pre = d.querySelector("pre");
        var id = d.dataset.review;
        pre.textContent = "loading…";
        fetch("/sessions/review?format=json&id=" + encodeURIComponent(id),
              { headers: { "Accept": "application/json" } })
          .then(function (r) { return r.ok ? r.json() : Promise.reject(r.status); })
          .then(function (data) {
            if (!data.found) { throw "gone"; }
            pre.textContent = data.review;
          })
          .catch(function () {
            // Put the link back, so the panel is never a dead end.
            loaded = false;
            pre.innerHTML = "";
            var a = document.createElement("a");
            a.href = "/sessions/review?id=" + encodeURIComponent(id);
            a.textContent = "could not load it here — open the review";
            pre.appendChild(a);
          });
      });
      // A panel restored open by keepPanels never fires toggle on its own.
      if (d.open) { d.dispatchEvent(new Event("toggle")); }
    });
  }

  // A log is read from its end: that is where a live run is, and a finished
  // trace keeps its newest lines for the same reason. Every one starts there,
  // and one opened later is taken there when it opens -- a closed panel has
  // no height to scroll while it is shut.
  function logsAtEnd(root) {
    root.querySelectorAll("pre.tail").forEach(function (pre) {
      pre.scrollTop = pre.scrollHeight;
      var d = pre.closest("details");
      if (d) {
        d.addEventListener("toggle", function () { if (d.open) { pre.scrollTop = pre.scrollHeight; } });
      }
    });
  }

  function wire(root) { keepPanels(root); enterSends(root); lazyReviews(root); logsAtEnd(root); }
  wire(document);
  return { wire: wire };
})();

// When a run ends, its card turns into the finished one -- the rendered answer,
// its stages, the follow-up box -- where it is, without a reload. A reload
// would throw away whatever is typed in another card's box, and where the page
// was scrolled; this used to need one by hand.
//
// The stream ends on the run's own state file, a few seconds before the worker
// writes the finished review into the database, and the finished card is drawn
// from the database. So: wait for that, then fetch the page and take this one
// card out of it. If anything goes wrong, the card says so and links to the
// page, which is what reloading by hand gave before.
function finish(id) {
  var card = document.getElementById("job-" + id);
  var status = document.getElementById("s-" + id);
  if (!card) return;
  if (status) { status.textContent = "finishing…"; }
  var tries = 0;
  function giveUp() {
    if (!status) return;
    status.textContent = "";
    var a = document.createElement("a");
    a.href = "/sessions";
    a.textContent = "finished — show the result";
    status.appendChild(a);
  }
  function wait() {
    fetch("/sessions/state?id=" + encodeURIComponent(id), { headers: { "Accept": "application/json" }, cache: "no-store" })
      .then(function (r) { return r.ok ? r.json() : Promise.reject(r.status); })
      .then(function (d) {
        if (!d.found) { throw "gone"; }
        if (!d.done) {
          // The worker writes it within a tick; half a minute is well past that.
          if (++tries < 30) { setTimeout(wait, 1000); return; }
          throw "slow";
        }
        return fetch("/sessions", { headers: { "Accept": "text/html" }, cache: "no-store" })
          .then(function (r) { return r.ok ? r.text() : Promise.reject(r.status); })
          .then(function (html) { swapIn(id, card, html); });
      })
      .catch(giveUp);
  }
  wait();
}

function swapIn(id, card, html) {
  var page = new DOMParser().parseFromString(html, "text/html");
  var fresh = page.getElementById("job-" + id);
  // Not among the finished ones -- torn down meanwhile, say: the link is the
  // honest answer.
  if (!fresh || !fresh.closest("#previous-list")) { throw "not finished on the page"; }
  var node = document.importNode(fresh, true);
  var previous = document.getElementById("previous-list");
  var empty = previous.querySelector(":scope > .empty");
  if (empty) { empty.remove(); }
  card.remove();
  // Newest finished first, which is how the page lists them too.
  previous.insertBefore(node, previous.firstChild);
  ["active-h", "previous-h"].forEach(function (h) {
    var mine = document.getElementById(h), theirs = page.getElementById(h);
    if (mine && theirs) { mine.textContent = theirs.textContent; }
  });
  var active = document.getElementById("active-list");
  if (!active.querySelector(".card") && !active.querySelector(".empty")) {
    var none = page.querySelector("#active-list > .empty");
    if (none) { active.appendChild(document.importNode(none, true)); }
  }
  RQ.wire(node);
}

(function () {
  var POLL = 2000;
  // Only panels that follow a job. A finished trace is a pre.tail too, and
  // without data-job this would have polled /sessions/tail?id=undefined every
  // six seconds, for every finished trace, for as long as the page was open.
  document.querySelectorAll("pre.tail[data-job]").forEach(function (pre) {
    var id = pre.dataset.job;
    var status = document.getElementById("s-" + id);
    var offset = new Blob([pre.textContent]).size;   // bytes, to match the server
    var stopped = false;

    function atBottom() {
      return pre.scrollHeight - pre.scrollTop - pre.clientHeight < 40;
    }

    // The review writes its log to a file on this server now, so the page can
    // be sent each line as it is written instead of asking every two seconds.
    // Polling stays as the fallback: an old browser, a proxy that will not do
    // event streams, or a job whose log file is not on this host.
    function append(text) {
      var stick = atBottom();
      pre.textContent += text;
      if (stick) { pre.scrollTop = pre.scrollHeight; }
    }

    function live() {
      if (!window.EventSource) { return tick(); }
      var es = new EventSource("/sessions/stream?id=" + encodeURIComponent(id) + "&offset=" + offset);
      var got = false;

      es.addEventListener("log", function (e) {
        got = true;
        var d = JSON.parse(e.data);
        offset = d.offset;
        append(d.text);
        if (status) { status.textContent = "live"; }
      });

      es.addEventListener("end", function (e) {
        got = true;
        var d = JSON.parse(e.data);
        offset = d.offset;
        stopped = true;
        if (status) { status.textContent = d.state; }
        es.close();
        finish(id);
      });

      // EventSource reconnects on its own when the server closes a stream at
      // its time limit, which is what should happen. It also fires onerror
      // when the endpoint answered 204 or 503 -- there is no stream to have,
      // so fall back rather than reconnecting for ever.
      es.onerror = function () {
        es.close();
        if (stopped) { return; }
        if (got) { setTimeout(live, 500); return; }
        if (status) { status.textContent = "live (polling)"; }
        tick();
      };
    }

    function tick() {
      if (stopped) return;
      fetch("/sessions/tail?id=" + encodeURIComponent(id) + "&offset=" + offset,
            { headers: { "Accept": "application/json" } })
        .then(function (r) { return r.ok ? r.json() : Promise.reject(r.status); })
        .then(function (d) {
          if (d.error) { throw d.error; }
          if (d.chunk) {
            var stick = atBottom();
            pre.textContent += d.chunk;
            offset = d.length;
            if (stick) { pre.scrollTop = pre.scrollHeight; }
          }
          if (status) { status.textContent = d.done ? d.state : (d.phase || "live"); }
          // Not a reload -- see finish().
          if (d.done) { stopped = true; finish(id); return; }
          setTimeout(tick, POLL);
        })
        .catch(function () {
          if (status) { status.textContent = "reconnecting…"; }
          setTimeout(tick, POLL * 3);
        });
    }
    live();
  });
})();
</script>
</body>
</html>
