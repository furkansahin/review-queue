<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Baybox · Review queue</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="" />
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
<style>
<%= PALETTE %>
  body { margin: 0; background: var(--bg); color: var(--fg);
         font-family: 'IBM Plex Sans', Helvetica, sans-serif; font-size: 14px; -webkit-font-smoothing: antialiased; }
  a { color: var(--link); text-decoration: none; }
  a:hover { color: var(--link-hover); text-decoration: underline; }
  .mono { font-family: 'IBM Plex Mono', monospace; }
  .bar { display: flex; align-items: center; gap: 16px; padding: 14px 24px; background: var(--surface);
         border-bottom: 1px solid var(--border); }
  .btn { font: 500 13px 'IBM Plex Sans', sans-serif; padding: 6px 14px; border: 1px solid var(--btn-border);
         background: var(--btn-bg); border-radius: 6px; cursor: pointer; color: var(--btn-fg); }
  .btn:hover { background: var(--btn-hover-bg); }
  .go { font: 600 13px 'IBM Plex Sans', sans-serif; padding: 8px 16px; border-radius: 7px; border: 0;
        background: var(--accent); color: var(--surface); cursor: pointer; }
  .go:hover { filter: brightness(1.08); }
  .danger { color: var(--err-fg); border-color: var(--err-border); }
  .wrap { max-width: 860px; padding: 22px 24px 80px; }
  h2 { font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted-2);
       font-family: 'IBM Plex Mono', monospace; font-weight: 600; margin: 26px 0 10px; }
  .card { background: var(--surface); border: 1px solid var(--border); border-radius: 10px;
          padding: 16px 18px; margin-bottom: 12px; }
  label { display: block; font-size: 11px; font-family: 'IBM Plex Mono', monospace;
          color: var(--muted-2); margin-bottom: 5px; }
  input[type=text], input[type=number] {
    font-family: 'IBM Plex Mono', monospace; font-size: 13px; padding: 7px 10px; border-radius: 6px;
    border: 1px solid var(--btn-border); background: var(--btn-bg); color: var(--fg); width: 100%; }
  .fields { display: flex; gap: 12px; flex-wrap: wrap; }
  .f-host { flex: 3 1 260px; } .f-user { flex: 1 1 120px; } .f-port { flex: 0 1 90px; }
  pre { background: var(--bg); border: 1px solid var(--border-soft); border-radius: 8px;
        padding: 12px 14px; overflow-x: auto; font-size: 12px; line-height: 1.5;
        font-family: 'IBM Plex Mono', monospace; white-space: pre-wrap; word-break: break-all;
        user-select: all; }
  .step { display: flex; gap: 12px; margin-bottom: 18px; }
  .num { flex: none; width: 22px; height: 22px; border-radius: 50%; background: var(--badge-bg);
         color: var(--badge-fg); font: 600 11px 'IBM Plex Mono', monospace;
         display: flex; align-items: center; justify-content: center; margin-top: 2px; }
  .note { font-size: 12px; color: var(--muted); line-height: 1.55; }
  .ok  { color: var(--age-fresh-fg); } .bad { color: var(--err-fg); }
  .banner { padding: 10px 14px; border-radius: 8px; font-size: 12px; margin-bottom: 14px;
            font-family: 'IBM Plex Mono', monospace; }
  .banner.err { background: var(--err-bg); border: 1px solid var(--err-border); color: var(--err-fg); }
</style>
</head>
<body>
<div class="bar">
  <div style="font-weight: 600; font-size: 15px; letter-spacing: -0.01em;">Baybox</div>
  <a class="mono" style="font-size: 12px;" href="/">← back to the queue</a>
  <a class="mono" style="font-size: 12px;" href="/sessions">sessions</a>
  <a class="mono" style="font-size: 12px;" href="/users">people</a>
  <div style="flex: 1;"></div>
  <div class="mono" style="font-size: 11px; color: var(--muted-2);">@<%= login %></div>
</div>

<div class="wrap">
  <% if error %><div class="banner err"><%= error %></div><% end %>
  <% if notice %><div class="banner" style="border-color: var(--btn-border);"><%= notice %></div><% end %>

  <div class="note" style="margin-bottom: 18px;">
    Reviews run on your own machine, not on this server. The dashboard generates its own key
    and you install only the public half, so your personal SSH key never comes here — and
    removing the box below really does revoke access.
  </div>

  <h2>Where it is</h2>
  <div class="card">
    <form method="post" action="/baybox/save">
      <%== csrf_save %>
      <div class="fields">
        <div class="f-host">
          <label for="host">host or IP</label>
          <input type="text" id="host" name="host" value="<%= box ? box["host"] : "" %>"
                 placeholder="10.0.0.5" required />
        </div>
        <div class="f-user">
          <label for="ssh_user">ssh user</label>
          <input type="text" id="ssh_user" name="ssh_user" value="<%= box ? box["ssh_user"] : "ubi" %>" />
        </div>
        <div class="f-port">
          <label for="port">port</label>
          <input type="number" id="port" name="port" value="<%= box ? box["port"] : 22 %>" min="1" max="65535" />
        </div>
      </div>
      <div style="margin-top: 14px;">
        <label for="repo_path">repo path on that machine</label>
        <input type="text" id="repo_path" name="repo_path" style="width: 100%;"
               value="<%= box ? box["repo_path"] : "" %>" placeholder="ubicloud" />
        <div class="note" style="margin-top: 6px;">
          Where your checkout of the repository sits, relative to your home directory.
          Default <span class="mono">ubicloud</span>.
        </div>
      </div>

      <div style="margin-top: 14px;">
        <label for="claude_token">Claude Code token</label>
        <input type="password" id="claude_token" name="claude_token" style="width: 100%;"
               autocomplete="new-password"
               placeholder="<%= box && box["claude_token_enc"] ? "stored — leave blank to keep it" : "sk-ant-oat01-…" %>" />
        <div class="note" style="margin-top: 6px;">
          Run <span class="mono">claude setup-token</span> in your terminal and paste what it prints.
        </div>
      </div>

      <div style="margin-top: 14px;">
        <label for="github_token">GitHub token</label>
        <input type="password" id="github_token" name="github_token" style="width: 100%;"
               autocomplete="new-password"
               placeholder="<%= box && box["github_token_enc"] ? "stored — leave blank to keep it" : "github_pat_…" %>" />
        <div class="note" style="margin-top: 6px;">
          <a href="https://github.com/settings/personal-access-tokens" target="_blank"
             rel="noreferrer">Make one here</a> — fine-grained, with
          <span class="mono">Contents: Read</span> on
          <%# Named from RQ_SCOPE, so it stays right if this dashboard is pointed
              somewhere else. An org-wide scope names no single repository. %>
          <% if scope_repos.empty? %>
            the repositories you review<%
          %><% else %><%
            %><% scope_repos.each_with_index do |repo, i| %><%
              %><%= i.zero? ? "" : ", " %><span class="mono"><%= repo %></span><%
            %><% end %><%
          %><% end %>.
        </div>
      </div>

      <div style="margin-top: 14px;">
        <label for="skills_repo">skills repository <span class="note">(optional)</span></label>
        <input type="text" id="skills_repo" name="skills_repo" style="width: 100%;"
               value="<%= box ? box["skills_repo"] : "" %>"
               placeholder="https://github.com/you/skills" />
        <div class="note" style="margin-top: 6px;">
          Put your Claude skills in a public repository — one directory per skill, each with a
          <span class="mono">SKILL.md</span> — and point this at it. Every new box gets them.
          A private one works too: it is cloned inside your box with your token above.
        </div>
      </div>

      <div class="note" style="margin-top: 14px;">
        Both tokens are encrypted with the same key as your SSH key and are never shown back
        here. Leave a field blank to keep what is stored, or type
        <span class="mono">-</span> to clear it.
      </div>
      <div style="margin-top: 14px; display: flex; gap: 8px; align-items: center;">
        <button class="go" type="submit"><%= box ? "Save" : "Register this baybox" %></button>
        <% if box %>
          <span class="note">Changing the address keeps your key, so there is nothing to reinstall.</span>
        <% end %>
      </div>
    </form>
  </div>

  <% if box %>

      <h2>Set up <span class="mono"><%= box["host"] %></span></h2>

      <div class="card">
        <div class="step">
          <div class="num">1</div>
          <div style="min-width: 0; flex: 1;">
            <div class="note" style="margin-bottom: 8px;">
              Run this on <span class="mono"><%= box["host"] %></span>. It is the one step
              nothing here can do for you: it is what gives the dashboard access.
            </div>
            <pre>echo '<%= authorized_line %>' >> ~/.ssh/authorized_keys</pre>
            <div class="note" style="margin-top: 8px;">
              <span class="mono">restrict</span> keeps the key to what bay needs — no port
              forwarding, no agent forwarding, no pty. Replacing an older line? Delete the one
              starting <span class="mono">command="/usr/local/bin/rq-review"</span>.
            </div>
          </div>
        </div>

        <div class="step">
          <div class="num">2</div>
          <div style="min-width: 0; flex: 1;">
            <div class="note" style="margin-bottom: 8px;">
              Then press this. It installs Docker, lets
              <span class="mono"><%= box["ssh_user"] %></span> use it, and clones the repository.
              A few minutes the first time; pressing it again does nothing it has already done.
            </div>
            <%# It runs for minutes and the page waits for it. Without this the
                button looked like it had done nothing, so it got pressed again,
                and the second apt-get fought the first one's dpkg lock. %>
            <form method="post" action="/baybox/prepare" style="margin: 0;"
                  onsubmit="var b=this.querySelector('button');
                            b.disabled=true; b.textContent='Preparing… this can take a few minutes';">
              <%== csrf_prepare %>
              <button class="go" type="submit">Prepare this box</button>
            </form>
            <div class="note" style="margin-top: 8px;">
              Needs <span class="mono">sudo</span> without a password. If it does not have that,
              it says so rather than stopping half way.
            </div>
          </div>
        </div>
      </div>
    <h2>Connection</h2>
    <div class="card">
      <div style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
        <form method="post" action="/baybox/test" style="margin: 0;">
          <%== csrf_test %>
          <button class="btn" type="submit">Test connection</button>
        </form>
        <% if box["last_error"] && !box["last_error"].to_s.empty? %>
          <span class="mono bad" style="font-size: 12px;">failed</span>
        <% elsif box["last_ok_at"] %>
          <span class="mono ok" style="font-size: 12px;">ok · last verified <%= box["last_ok_at"] %></span>
        <% else %>
          <span class="mono" style="font-size: 12px; color: var(--muted-2);">not tested yet</span>
        <% end %>
      </div>
      <% if box["last_error"] && !box["last_error"].to_s.empty? %>
        <pre style="margin-top: 12px;"><%= box["last_error"] %></pre>
      <% end %>
    </div>

    <h2>Key</h2>
    <div class="card">
      <div class="note" style="margin-bottom: 10px;">
        Rotating generates a new keypair and invalidates the old one. You then reinstall the
        line above. Removing the baybox deletes the private key from this server entirely.
      </div>
      <div style="display: flex; gap: 8px;">
        <form method="post" action="/baybox/rotate" style="margin: 0;">
          <%== csrf_rotate %>
          <button class="btn" type="submit">Rotate key</button>
        </form>
        <form method="post" action="/baybox/delete" style="margin: 0;">
          <%== csrf_delete %>
          <button class="btn danger" type="submit">Remove baybox</button>
        </form>
      </div>
    </div>
  <% end %>
</div>
</body>
</html>
