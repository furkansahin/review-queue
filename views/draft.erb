<%
  ready = plan[:placed] && !plan[:error]
  total = ready ? plan[:placed].size + plan[:loose].size : 0
%>
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Draft · #<%= job["pr_number"] %> · Leeghwater</title>
<link rel="icon" href="<%= Logo.favicon_href(last_fill) %>" type="image/svg+xml" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="" />
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
<style>
<%= PALETTE %>
  body { margin: 0; background: var(--bg); color: var(--fg);
         font-family: 'IBM Plex Sans', Helvetica, sans-serif; font-size: 14px; -webkit-font-smoothing: antialiased; }
  a { color: var(--link); text-decoration: none; }
  a:hover { color: var(--link-hover); text-decoration: underline; }
  .mono { font-family: 'IBM Plex Mono', monospace; }
  .bar { display: flex; align-items: center; gap: 16px; padding: 14px 24px; background: var(--surface);
         border-bottom: 1px solid var(--border); }
  .wrap { max-width: 900px; padding: 22px 24px 80px; }
  .card { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 18px 20px; margin-bottom: 14px; }
  .quiet { color: var(--muted); }
  h2 { font: 600 12px 'IBM Plex Mono', monospace; letter-spacing: 0.08em; text-transform: uppercase;
       color: var(--muted-2); margin: 22px 0 10px; }
  .summary { white-space: pre-wrap; line-height: 1.55; }
  .comment { border: 1px solid var(--border-soft); border-radius: 8px; padding: 10px 14px; margin-bottom: 10px;
             display: flex; gap: 12px; align-items: flex-start; }
  .comment > div { min-width: 0; flex: 1; }
  .comment input[type=checkbox] { margin: 3px 0 0; width: 16px; height: 16px; flex: none; cursor: pointer; accent-color: var(--accent); }
  /* An unticked comment stays readable, but plainly out. */
  .comment:has(input:not(:checked)) > div { opacity: 0.4; }
  .comment:has(input:not(:checked)) .where::after { content: " · left out"; color: var(--err-fg); }
  .kept { font: 12px 'IBM Plex Mono', monospace; color: var(--muted); }
  .where { font: 12px 'IBM Plex Mono', monospace; color: var(--muted); margin-bottom: 6px; overflow-wrap: anywhere; }
  /* The comment as it will be sent, editable where it stands: text until you
     point at it, a field when you click. */
  textarea.body { display: block; width: 100%; box-sizing: border-box; margin: 0; padding: 4px 6px; resize: none;
                  overflow: hidden; font: 13px/1.5 'IBM Plex Sans', Helvetica, sans-serif; color: var(--fg);
                  background: transparent; border: 1px solid transparent; border-radius: 6px; }
  textarea.body:hover { border-color: var(--border); }
  textarea.body:focus { outline: none; border-color: var(--accent); background: var(--bg); }
  .edited { color: var(--accent); }
  .revert { font: inherit; color: var(--link); background: none; border: 0; padding: 0; cursor: pointer; }
  .banner { padding: 10px 14px; border-radius: 8px; font-size: 12px; margin-bottom: 14px; line-height: 1.5;
            font-family: 'IBM Plex Mono', monospace; }
  .banner.err { background: var(--err-bg); border: 1px solid var(--err-border); color: var(--err-fg); }
  .banner.ok { background: var(--chip-blue-bg); border: 1px solid var(--chip-blue-br); color: var(--chip-blue-fg); }
  .caution { padding: 10px 14px; border-radius: 8px; font-size: 13px; line-height: 1.5;
             background: var(--chip-grey-bg); color: var(--fg); }
  .go { font: 600 13px 'IBM Plex Sans', sans-serif; padding: 9px 16px; border-radius: 7px; border: 0;
        background: var(--accent); color: var(--surface); cursor: pointer; }
  .go:hover { filter: brightness(1.08); }
  .go:disabled { opacity: 0.45; cursor: not-allowed; filter: none; }
  .actions { display: flex; align-items: center; gap: 10px; margin-top: 16px; flex-wrap: wrap; }
  .pending { margin-top: 16px; padding: 14px 16px; border-radius: 8px; border: 1px solid var(--chip-blue-br);
             background: var(--chip-blue-bg); font-size: 13px; line-height: 1.5; }
  textarea.body.framed { border-color: var(--border); background: var(--surface); }
  .linkish { font: 12px 'IBM Plex Mono', monospace; color: var(--link); background: none; border: 0; padding: 0; cursor: pointer; }
  .linkish:disabled { opacity: 0.45; cursor: not-allowed; }
</style>
</head>
<body>
<div class="bar">
  <div style="display: flex; align-items: center; gap: 9px; font-weight: 600; font-size: 15px; letter-spacing: -0.01em;">
    <a href="/" title="Leeghwater: the queue" style="color: inherit;"><%== Logo.svg(20, fill: last_fill) %></a>Draft on GitHub
  </div>
  <a class="mono" style="font-size: 12px;" href="/sessions#job-<%= job["id"] %>">← back to the review</a>
</div>

<div class="wrap">
  <% if notice %>
    <div class="banner ok"><%= notice %><% if job["draft_url"] %> · <a href="<%= job["draft_url"] %>" target="_blank" rel="noreferrer">open it ↗</a><% end %></div>
  <% end %>
  <% if error %><div class="banner err"><%= error %></div><% end %>
  <% if job["learn_note"] %>
    <div class="banner ok"><%= job["learn_note"] %> · <a href="/baybox#voice">your review voice</a></div>
  <% end %>

  <div class="card">
    <div style="display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap;">
      <span style="font-weight: 600; font-size: 15px;"><%= ready ? plan[:title] : "#{job["repo"]} ##{job["pr_number"]}" %></span>
      <a class="mono" style="font-size: 12px;" href="https://github.com/<%= job["repo"] %>/pull/<%= job["pr_number"] %>" target="_blank" rel="noreferrer"><%= job["repo"] %> #<%= job["pr_number"] %> ↗</a>
      <% if job["draft_url"] && !notice %>
        <a class="mono" style="font-size: 12px;" href="<%= job["draft_url"] %>" target="_blank" rel="noreferrer">drafted before ↗</a>
      <% end %>
    </div>

    <% if plan[:running] %>
      <p class="quiet">The box is still working on this review. Come back when it has finished.</p>
    <% elsif plan[:missing] %>
      <p>This review was written before the box wrote its findings down for GitHub.</p>
      <form method="post" action="/sessions/draft/ask?id=<%= job["id"] %>" style="margin: 0;">
        <%== csrf_ask %>
        <div class="actions" style="margin-top: 4px;">
          <button class="go" type="submit">Ask the box to write them</button>
          <span class="quiet" style="font-size: 12px;">a follow-up in the same conversation; it takes a minute or two</span>
        </div>
      </form>
    <% elsif plan[:error] %>
      <div class="banner err" style="margin: 14px 0 0;"><%= plan[:error] %></div>
    <% else %>
      <p class="quiet" style="margin: 10px 0 0;">
        Against <a class="mono" href="https://github.com/<%= job["repo"] %>/commit/<%= plan[:commit] %>" target="_blank" rel="noreferrer"><%= plan[:commit][0, 10] %></a>,
        the commit the box reviewed<% if plan[:moved] %>; the pull request has moved on since, so GitHub shows these against that older commit<% end %>.
      </p>

      <%# A pending review's comments are on GitHub, and nothing here would change
          them: the box's findings are shown only when there is something to post. %>
      <% unless plan[:pending] %>
      <h2>Summary</h2>
      <div class="comment" style="border-style: dashed;">
        <div>
          <div class="where">the review's body<span class="edited" hidden> · edited · <button type="button" class="revert">revert</button></span></div>
          <textarea class="body" form="draft-form" name="summary" rows="1" spellcheck="true" placeholder="(none)"
                    aria-label="the review's summary, as it will be sent" data-original="<%= plan[:summary] %>"><%= plan[:summary] %></textarea>
        </div>
      </div>

      <h2><%= plan[:placed].size %> on the lines</h2>
      <% if plan[:placed].empty? %><p class="quiet">None.</p><% end %>
      <%# Numbered as GitHubDraft.keep counts them: these first, then the ones
          for the summary. The boxes belong to the form at the bottom. %>
      <% plan[:placed].each_with_index do |c, i| %>
        <div class="comment">
          <input type="checkbox" form="draft-form" name="keep[]" value="<%= i %>" checked="checked"
                 aria-label="keep this comment" />
          <div>
            <div class="where"><%= c[:path] %> · <%= c[:side] == "LEFT" ? "removed line" : "line" %> <%= c[:line] %><span class="edited" hidden> · edited · <button type="button" class="revert">revert</button></span></div>
            <textarea class="body" form="draft-form" name="body[<%= i %>]" rows="1" spellcheck="true"
                      aria-label="the comment, as it will be sent" data-original="<%= c[:body] %>"><%= c[:body] %></textarea>
          </div>
        </div>
      <% end %>

      <% unless plan[:loose].empty? %>
        <h2><%= plan[:loose].size %> in the summary</h2>
        <p class="quiet" style="margin-top: 0;">On lines the pull request does not change, so GitHub cannot take them as line comments.</p>
        <% plan[:loose].each_with_index do |c, i| %>
          <div class="comment">
          <input type="checkbox" form="draft-form" name="keep[]" value="<%= plan[:placed].size + i %>" checked="checked"
                 aria-label="keep this comment" />
          <div>
            <div class="where"><%= c[:path] %> · line <%= c[:line] %><span class="edited" hidden> · edited · <button type="button" class="revert">revert</button></span></div>
            <textarea class="body" form="draft-form" name="body[<%= plan[:placed].size + i %>]" rows="1" spellcheck="true"
                      aria-label="the comment, as it will be sent" data-original="<%= c[:body] %>"><%= c[:body] %></textarea>
          </div>
        </div>
        <% end %>
      <% end %>
      <% end %>

      <% if plan[:pending] %>
        <% ours = drafted_id && plan[:pending][:id] == drafted_id %>
        <div class="pending">
          <div>
            <strong><%= ours ? "Your draft is pending on GitHub." : "You have a pending review on this pull request, begun on GitHub." %></strong>
            Nobody sees it until it is submitted, and GitHub allows one at a time.
            Its comments are the ones there: <a href="<%= plan[:pending][:url] %>" target="_blank" rel="noreferrer">read or edit them on GitHub ↗</a>.
          </div>
          <form method="post" action="/sessions/draft/submit?id=<%= job["id"] %>" style="margin: 0;">
            <%== csrf_submit %>
            <input type="hidden" name="review" value="<%= plan[:pending][:id] %>" />
            <div class="where" style="margin: 12px 0 4px;">its summary</div>
            <textarea class="body framed" name="summary" rows="2" spellcheck="true" placeholder="(none)"
                      aria-label="the pending review's summary"><%= plan[:pending][:body] %></textarea>
            <div class="actions">
              <% GitHubDraft::EVENTS.each do |event, label| %>
                <button class="go" type="submit" name="event" value="<%= event %>" <%= "disabled" unless can_write %>><%= label %></button>
              <% end %>
            </div>
          </form>
          <% if ours %>
            <form method="post" action="/sessions/draft/discard?id=<%= job["id"] %>" style="margin: 10px 0 0;">
              <%== csrf_discard %>
              <input type="hidden" name="review" value="<%= plan[:pending][:id] %>" />
              <button class="linkish" type="submit" <%= "disabled" unless can_write %>>discard it and its comments, to post again from this page</button>
            </form>
          <% end %>
        </div>
      <% else %>

      <div class="caution" style="margin-top: 16px;">
        This posts the review on the pull request under your name: the summary and the comments ticked above,
        as you have worded them.
      </div>

      <form id="draft-form" method="post" action="/sessions/draft?id=<%= job["id"] %>" style="margin: 0;">
        <%== csrf %>
        <input type="hidden" name="digest" value="<%= plan[:digest] %>" />
        <div class="actions">
          <% if total.positive? %><span class="kept" id="kept"><%= total %> of <%= total %> kept</span><% end %>
          <div style="flex: 1;"></div>
          <% unless can_write %>
            <span class="mono" style="font-size: 11px; color: var(--err-fg);">needs a write token, on the <a href="/baybox">Baybox page</a></span>
          <% end %>
          <% GitHubDraft::EVENTS.each do |event, label| %>
            <button class="go" type="submit" name="event" value="<%= event %>" <%= "disabled" unless can_write %>><%= label %></button>
          <% end %>
        </div>
        <div style="text-align: right; margin-top: 6px;">
          <button class="linkish" type="submit" name="event" value="" <%= "disabled" unless can_write %>>or leave it pending, to finish on GitHub</button>
        </div>
      </form>
      <% end %>
    <% end %>
  </div>
</div>
<script>
// Each comment grows to its text, and says when it no longer reads as the box
// wrote it, with a way back.
document.querySelectorAll("textarea.body").forEach(function (ta) {
  var mark = ta.parentNode.querySelector(".edited");
  function fit() { ta.style.height = "auto"; ta.style.height = ta.scrollHeight + 2 + "px"; }
  function edited() {
    if (!mark) return;   // a field with nothing to go back to, like a pending review's summary
    mark.hidden = ta.value.trim().split(/\s+/).join(" ") === ta.dataset.original.trim().split(/\s+/).join(" ");
  }
  ta.addEventListener("input", function () { fit(); edited(); });
  if (mark) mark.querySelector(".revert").addEventListener("click", function () { ta.value = ta.dataset.original; fit(); edited(); });
  fit();
});

// The count by the button. Without it the page still works: it only counts.
(function () {
  var out = document.getElementById("kept");
  if (!out) return;
  var boxes = document.querySelectorAll('input[name="keep[]"]');
  function count() {
    var n = Array.prototype.filter.call(boxes, function (b) { return b.checked; }).length;
    out.textContent = n + " of " + boxes.length + " kept";
  }
  boxes.forEach(function (b) { b.addEventListener("change", count); });
})();
</script>
</body>
</html>
